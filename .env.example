# Copy to .env (gitignored). All variables are optional — the site degrades
# cleanly when each is absent. Keys marked CLIENT are inlined into the bundle
# at build time; keys marked SERVER are only readable from API routes /
# build-time scripts.

# CLIENT — Google Analytics 4 measurement ID (Partytown loads gtag.js).
# When unset, the Analytics component is a no-op and no GA script ships.
GA_MEASUREMENT_ID=

# CLIENT — Giscus configuration. Visit https://giscus.app to generate.
# When any of these is unset, the Giscus comment island doesn't render.
GISCUS_REPO=kevinkiklee/kevinkiklee.io
GISCUS_REPO_ID=
GISCUS_CATEGORY=General
GISCUS_CATEGORY_ID=

# CLIENT — Mastodon presence. Used for the rel="me" link in <head> and the
# "discuss on Mastodon" link in DiscussFooter.
MASTODON_HANDLE=@kevin@mastodon.social
MASTODON_INSTANCE_URL=https://mastodon.social/@kevin

# SERVER — Webmention.io endpoint token. When unset, the webmention sender
# script is a no-op.
WEBMENTION_TOKEN=

# SERVER — Vercel deploy hook URL invoked by /api/refresh on the weekly
# cron. When unset, the endpoint returns 503.
VERCEL_DEPLOY_HOOK_URL=

# SERVER — Bearer token Vercel Cron sends with the Authorization header.
# /api/refresh rejects requests that don't match.
CRON_SECRET=

# SERVER — Sentry DSN scoped to the /api/og endpoint. Optional; failures
# are logged to console when unset.
SENTRY_DSN_OG=

# CI — IndexNow shared secret. The push-to-main workflow pings search
# engines after a successful build. Unused locally.
INDEXNOW_KEY=
