{
  "name": "kevinkiklee-io",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "astro check && biome ci . && cspell '**/*.{md,mdx}' --no-progress && markdownlint-cli2 '**/*.{md,mdx}'",
    "format": "biome format --write .",
    "fonts:subset": "tsx scripts/subset-fonts.ts",
    "new:post": "tsx scripts/new-post.ts",
    "new:project": "tsx scripts/new-project.ts",
    "analyze": "open stats.html",
    "links:check": "lychee --no-progress dist/",
    "preview:static": "serve dist/client -p 4321 --no-clipboard --single",
    "a11y:audit": "tsx scripts/a11y/audit.ts",
    "a11y:audit:primary": "tsx scripts/a11y/audit.ts --primary-only",
    "lighthouse": "lhci collect --url=http://localhost:4321"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/partytown": "^2.0.0",
    "@astrojs/rss": "^4.0.0",
    "@astrojs/sitemap": "^3.0.0",
    "@astrojs/vercel": "^9.0.5",
    "@sentry/node": "^10.51.0",
    "@vercel/analytics": "^1.4.0",
    "@vercel/og": "^0.11.1",
    "@vercel/speed-insights": "^1.1.0",
    "astro": "^5.0.0",
    "astro-pagefind": "^1.6.0",
    "mdast-util-to-string": "^4.0.0",
    "pagefind": "^1.1.0",
    "satori": "^0.12.0",
    "satori-html": "^0.3.2",
    "web-vitals": "^4.2.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.11.3",
    "@biomejs/biome": "1.9.4",
    "@commitlint/cli": "19.6.0",
    "@commitlint/config-conventional": "19.6.0",
    "@lhci/cli": "0.14.0",
    "@playwright/test": "^1.59.1",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "24.12.2",
    "@vercel/config": "^0.2.1",
    "axe-core": "4.10.0",
    "cspell": "8.16.0",
    "jsdom": "^29.1.1",
    "linkedom": "^0.18.12",
    "lint-staged": "15.2.10",
    "lychee": "*",
    "markdownlint-cli2": "0.15.0",
    "mdast-util-to-markdown": "^2.1.0",
    "playwright": "^1.59.1",
    "remark-mdx": "^3.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "rollup-plugin-visualizer": "5.12.0",
    "serve": "^14.2.6",
    "simple-git-hooks": "2.11.1",
    "subset-font": "^2.5.0",
    "tsx": "4.19.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vitest": "^2.1.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "commit-msg": "pnpm exec commitlint --edit $1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,astro}": [
      "biome format --write",
      "biome lint"
    ],
    "*.{md,mdx}": [
      "cspell --no-progress --no-must-find-files",
      "markdownlint-cli2"
    ]
  }
}
