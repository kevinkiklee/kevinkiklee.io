{
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD036": false,
    "MD041": false
  },
  "ignores": [
    "node_modules/**",
    "dist/**",
    ".astro/**",
    ".vercel/**",
    ".lighthouseci/**",
    "playwright-report/**",
    "docs/**",
    "a11y-findings.md",
    ".aider*",
    // Gitignored SDD planning/tracking artifacts (task briefs, progress
    // ledgers, per-task reports) — never committed, not shipped content.
    // cspell already skips these implicitly; markdownlint-cli2 does not
    // honor .gitignore by default, so it needs an explicit entry here.
    ".superpowers/**"
  ]
}
