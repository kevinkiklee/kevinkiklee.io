---
import { MASTODON_INSTANCE_URL } from 'astro:env/client';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import JsonLd from '~/components/JsonLd.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { crumbsFor } from '~/lib/crumbs';
import { buildBreadcrumbs, buildPageGraph, buildPerson, buildWebSite } from '~/lib/schema';
import { SITE, pageTitle, resolveMastodonProfile } from '~/lib/site-config';

const mastodon = resolveMastodonProfile(MASTODON_INSTANCE_URL);
const person = buildPerson({
  mastodon,
  github: SITE.github,
  linkedin: SITE.linkedin,
  bluesky: SITE.bsky,
  bio: SITE.bio,
  portraitUrl: SITE.portraitUrl,
});
const crumbs = crumbsFor('/about');
const graph = buildPageGraph([person, buildBreadcrumbs(crumbs, SITE.url), buildWebSite()]);
---
<BaseLayout title={pageTitle('About')} description="Lorem ipsum dolor sit amet, consectetur adipiscing elit." ogType="profile" profileFirstName="Kevin" profileLastName="Lee">
  <JsonLd slot="head" data={graph} />
  <Breadcrumbs items={crumbs} />
  <article class="h-card">
    <h1 class="page-title">About</h1>
    <p class="lead">
      Hi, I'm <a class="p-name u-url" rel="me author" href={SITE.url}>{SITE.author}</a>.
      I work as a <span class="p-job-title">{SITE.jobTitle}</span>
      at <span class="p-org">{SITE.org}</span>.
    </p>
    <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam.</p>
    <p class="credentials">
      Quis nostrud: exercitation ullamco. Laboris nisi: ut aliquip, ex ea commodo, consequat duis.
    </p>
    <h2>Find me</h2>
    {/* `rel="me noopener noreferrer"` — `me` preserves the IndieWeb identity
        verification signal; `noopener`/`noreferrer` plug the `window.opener`
        leak and suppress the Referer header on cmd-click new-tab opens. */}
    <ul class="links" role="list">
      <li><a class="u-url" rel="me noopener noreferrer" href={mastodon}><span class="ar" aria-hidden="true">↗</span> Mastodon — primary social</a></li>
      <li><a class="u-url" rel="me noopener noreferrer" href={SITE.github}><span class="ar" aria-hidden="true">↗</span> GitHub</a></li>
      <li><a class="u-url" rel="me noopener noreferrer" href={SITE.linkedin}><span class="ar" aria-hidden="true">↗</span> LinkedIn</a></li>
    </ul>
    <p class="discuss">Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia.</p>
  </article>
</BaseLayout>

<style>
  .page-title {
    font-size: var(--text-2xl);
    letter-spacing: -0.01em;
    line-height: var(--leading-tight);
    margin-bottom: var(--space-6);
  }
  .lead { font-size: var(--text-lg); max-width: var(--measure); }
  .credentials { color: var(--fg-muted); margin-top: var(--space-3); }
  h2 {
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: -0.005em;
    border-bottom: 2px solid var(--rule);
    padding-bottom: var(--space-2);
    margin: var(--space-7) 0 var(--space-3);
  }
  .links { list-style: none; padding: 0; }
  .links li { padding: var(--space-2) 0; }
  .links a { display: inline-flex; align-items: center; min-height: 44px; }
  .links .ar { color: var(--accent); margin-right: 0.3em; display: inline-block; transition: transform 180ms var(--ease); }
  @media (hover: hover) and (pointer: fine) {
    .links a:hover .ar { transform: translate(2px, -2px); }
  }
  .discuss { margin-top: var(--space-5); color: var(--fg-muted); }
</style>
