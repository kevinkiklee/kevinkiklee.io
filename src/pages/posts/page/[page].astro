---
import type { GetStaticPaths } from 'astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import JsonLd from '~/components/JsonLd.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { crumbsFor } from '~/lib/crumbs';
import { getPublishedPosts, sortByDateDesc } from '~/lib/posts';
import {
  ENTITY_IDS,
  buildBlog,
  buildBreadcrumbs,
  buildCollectionPage,
  buildItemListOfBlogPostings,
  buildPageGraph,
  buildWebSite,
} from '~/lib/schema';
import { SITE } from '~/lib/site-config';

export const getStaticPaths = (async () => {
  // Astro hoists getStaticPaths and runs it in isolation; module-scope
  // constants aren't visible. Keep config local to the function.
  const PAGE_SIZE = 30;
  const posts = sortByDateDesc(await getPublishedPosts());
  const totalPages = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
  // Page 1 lives at /posts (year-grouped). Numbered pages are 2..N.
  const out: {
    params: { page: string };
    props: { items: typeof posts; page: number; totalPages: number };
  }[] = [];
  for (let page = 2; page <= totalPages; page += 1) {
    const start = (page - 1) * PAGE_SIZE;
    const items = posts.slice(start, start + PAGE_SIZE);
    out.push({ params: { page: String(page) }, props: { items, page, totalPages } });
  }
  return out;
}) satisfies GetStaticPaths;

const { items, page, totalPages } = Astro.props;
const canonical = new URL(`/posts/page/${page}`, Astro.site).toString();
const prevHref = page === 2 ? '/posts' : `/posts/page/${page - 1}`;
const nextHref = page < totalPages ? `/posts/page/${page + 1}` : null;

const itemListId = `${SITE.url}${Astro.url.pathname}#list`;
const crumbs = crumbsFor(Astro.url.pathname);
const graph = buildPageGraph([
  buildCollectionPage({
    url: canonical,
    name: 'Posts',
    description: 'Archive of all posts.',
    itemListId,
  }),
  buildBlog(),
  buildItemListOfBlogPostings({
    id: itemListId,
    posts: items.map((p) => ({
      url: `${SITE.url}/posts/${p.id}`,
      title: p.data.title,
    })),
  }),
  buildBreadcrumbs(crumbs, SITE.url),
  buildWebSite(),
  { '@id': ENTITY_IDS.person },
]);
---
<BaseLayout
  title={`Posts · page ${page}`}
  description="Older posts."
  canonical={canonical}
  prevUrl={new URL(prevHref, Astro.site).toString()}
  nextUrl={nextHref ? new URL(nextHref, Astro.site).toString() : undefined}
>
  <JsonLd slot="head" data={graph} />
  <Breadcrumbs items={crumbs} />
  <h1 class="page-title">Posts <span class="page-num">— page {page}/{totalPages}</span></h1>
  <section>
    <h2 class="sr-only">Post archive</h2>
    <ul role="list" class="archive">
    {items.map((p) => (
      <li>
        <a href={`/posts/${p.id}`}>
          <h3>
            <time datetime={p.data.pubDate.toISOString()}>{p.data.pubDate.toISOString().slice(0, 10)}</time>
            <span>{p.data.title}</span>
          </h3>
        </a>
      </li>
    ))}
  </ul>
  </section>
  <nav aria-label="Pagination" class="pager">
    <a href={prevHref}>← newer</a>
    {' · '}
    {nextHref ? <a href={nextHref}>older →</a> : <span aria-hidden="true">older →</span>}
  </nav>
</BaseLayout>

<style>
  .page-title {
    font-size: var(--text-2xl);
    letter-spacing: -0.01em;
    line-height: var(--leading-tight);
    margin-bottom: var(--space-6);
  }
  .page-num {
    font-size: var(--text-base);
    color: var(--fg-muted);
    font-weight: 400;
    letter-spacing: 0;
  }
  .archive { font-variant-numeric: tabular-nums; }
  .archive li {
    padding: var(--space-2) 0;
    border-top: 1px solid var(--rule-soft);
    content-visibility: auto;
    contain-intrinsic-size: 1px 60px;
  }
  .archive h3 {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: var(--space-4);
    align-items: baseline;
    min-height: 44px;
    font-size: var(--text-base);
    font-weight: 400;
    font-family: var(--font-mono);
    letter-spacing: 0;
    text-transform: none;
    line-height: var(--leading-body);
  }
  .archive time { color: var(--fg-subtle); font-size: var(--text-sm); }
  .pager { margin-top: var(--space-6); font-size: var(--text-sm); color: var(--fg-muted); }
  .pager span { color: var(--fg-subtle); }
</style>
