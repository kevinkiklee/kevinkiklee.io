---
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import JsonLd from '~/components/JsonLd.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { crumbsFor } from '~/lib/crumbs';
import { formatMonthDay } from '~/lib/format';
import { getPublishedPosts, sortByDateDesc } from '~/lib/posts';
import {
  ENTITY_IDS,
  buildBlog,
  buildBreadcrumbs,
  buildCollectionPage,
  buildItemListOfBlogPostings,
  buildPageGraph,
  buildWebSite,
} from '~/lib/schema';
import { SITE } from '~/lib/site-config';

const allPosts = sortByDateDesc(await getPublishedPosts());
const posts = allPosts.slice(0, 30);
const hasOlder = allPosts.length > 30;
const groupedByYear = posts.reduce<Record<number, typeof posts>>((acc, p) => {
  const y = p.data.pubDate.getFullYear();
  const bucket = acc[y] ?? [];
  bucket.push(p);
  acc[y] = bucket;
  return acc;
}, {});
const years = Object.keys(groupedByYear)
  .map(Number)
  .sort((a, b) => b - a);

const itemListId = `${SITE.url}/posts#list`;
const crumbs = crumbsFor('/posts');
const graph = buildPageGraph([
  buildCollectionPage({
    url: `${SITE.url}/posts`,
    name: 'Posts',
    description: 'Archive of all posts.',
    itemListId,
  }),
  buildBlog(),
  buildItemListOfBlogPostings({
    id: itemListId,
    posts: posts.map((p) => ({
      url: `${SITE.url}/posts/${p.id}`,
      title: p.data.title,
    })),
  }),
  buildBreadcrumbs(crumbs, SITE.url),
  buildWebSite(),
  { '@id': ENTITY_IDS.person },
]);
---
<BaseLayout title="Posts · kevinkiklee.io" description="Archive of all posts.">
  <JsonLd slot="head" data={graph} />
  <Breadcrumbs items={crumbs} />
  <h1 class="page-title">Posts</h1>
  {posts.length === 0 && (
    <p class="empty">No posts yet — check back soon.</p>
  )}
  {years.map((year) => (
    <section>
      <h2>{year}</h2>
      <ul role="list" class="archive">
        {(groupedByYear[year] ?? []).map((p) => (
          <li>
            <a href={`/posts/${p.id}`}>
              <h3>
                <time datetime={p.data.pubDate.toISOString()}>{formatMonthDay(p.data.pubDate)}</time>
                <span>{p.data.title}</span>
              </h3>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
  {hasOlder && (
    <p class="more"><a href="/posts/page/2">→ older posts</a></p>
  )}
</BaseLayout>

<style>
  .page-title {
    font-size: var(--text-2xl);
    letter-spacing: -0.01em;
    line-height: var(--leading-tight);
    margin-bottom: var(--space-6);
  }
  h2 {
    font-size: var(--text-lg);
    letter-spacing: -0.005em;
    border-bottom: 2px solid var(--rule);
    padding-bottom: var(--space-2);
    margin: var(--space-6) 0 var(--space-3);
  }
  .archive { font-variant-numeric: tabular-nums; }
  .archive li {
    padding: var(--space-2) 0;
    border-top: 1px solid var(--rule-soft);
    content-visibility: auto;
    contain-intrinsic-size: 1px 60px;
  }
  /* Visually compress the per-post h3 to a one-liner; keep semantics intact for
     screen-reader rotor + AEO. */
  .archive h3 {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: var(--space-4);
    align-items: baseline;
    min-height: 44px;
    font-size: var(--text-base);
    font-weight: 400;
    font-family: var(--font-mono);
    letter-spacing: 0;
    text-transform: none;
    line-height: var(--leading-body);
  }
  .archive time { color: var(--fg-subtle); font-size: var(--text-sm); }
  .more { margin-top: var(--space-6); font-size: var(--text-xs); }
  .empty { color: var(--fg-muted); font-style: italic; padding: var(--space-5) 0; }
</style>
