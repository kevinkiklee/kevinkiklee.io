---
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import JsonLd from '~/components/JsonLd.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { crumbsFor } from '~/lib/crumbs';
import { getPublishedPosts, tagCounts } from '~/lib/posts';
import {
  buildBreadcrumbs,
  buildCollectionPage,
  buildItemListOfDefinedTerms,
  buildPageGraph,
  buildWebSite,
} from '~/lib/schema';
import { SITE, pageTitle } from '~/lib/site-config';

const counts = tagCounts(await getPublishedPosts());
const tags = Object.entries(counts).sort(([, a], [, b]) => b - a);

const tagsForList = Object.keys(counts).map((tag) => ({
  name: tag,
  url: `${SITE.url}/tags/${tag}`,
}));
const itemListId = `${SITE.url}/tags#list`;
const crumbs = crumbsFor('/tags');
const graph = buildPageGraph([
  buildCollectionPage({
    url: `${SITE.url}/tags`,
    name: 'Tags',
    description: 'All tags.',
    itemListId,
  }),
  buildItemListOfDefinedTerms({ id: itemListId, tags: tagsForList }),
  buildBreadcrumbs(crumbs, SITE.url),
  buildWebSite(),
]);
---
<BaseLayout title={pageTitle('Tags')} description="Browse posts by tag.">
  <JsonLd slot="head" data={graph} />
  <Breadcrumbs items={crumbs} />
  <div class="title-row">
    <h1 class="page-title">Tags</h1>
    <span class="garden swallow-a" aria-hidden="true">
      <svg viewBox="0 0 40 20" width="26" height="13">
        <path d="M2 13 C8 5 14 5 20 11 C26 5 32 5 38 13 M20 11 L20 14"
          fill="none" stroke="var(--garden-ink)" stroke-width="1.2" stroke-linecap="round" />
      </svg>
    </span>
    <span class="garden swallow-b" aria-hidden="true">
      <svg viewBox="0 0 40 20" width="26" height="13">
        <path d="M2 13 C8 5 14 5 20 11 C26 5 32 5 38 13 M20 11 L20 14"
          fill="none" stroke="var(--garden-ink)" stroke-width="1.2" stroke-linecap="round" />
      </svg>
    </span>
  </div>
  {tags.length === 0 ? (
    <p class="empty">No tags yet — tags appear once posts are published.</p>
  ) : (
    <ul role="list" class="tag-grid">
      {tags.map(([tag, count]) => (
        <li><a href={`/tags/${tag}`}>{tag} <span class="count">{count}</span></a></li>
      ))}
    </ul>
  )}
</BaseLayout>

<style>
  .title-row {
    position: relative;
    display: inline-flex;
    align-items: baseline;
  }
  .page-title {
    font-size: var(--text-2xl);
    letter-spacing: -0.01em;
    line-height: var(--leading-tight);
    margin-bottom: var(--space-6);
  }
  /* Two static swallows (no garden-fly animation — see Task 9 brief) drift
     just above the heading, offset so they read as a small pair in flight
     rather than a stacked duplicate. */
  .swallow-a, .swallow-b { position: absolute; top: -14px; opacity: 0.55; }
  .swallow-a { left: 10ch; }
  .swallow-b { left: 15ch; top: -20px; }
  @media (max-width: 640px) { .swallow-a, .swallow-b { display: none; } }
  .tag-grid { display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); }
  .tag-grid a {
    padding: var(--space-3);
    border: 1px solid var(--rule-soft);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    min-height: 44px;
    transition: border-color 180ms var(--ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .tag-grid a:hover { border-color: var(--rule); }
  }
  .count {
    color: var(--fg-subtle);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }
  .empty { color: var(--fg-muted); font-style: italic; padding: var(--space-5) 0; }
</style>
