---
import type { GetStaticPaths } from 'astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import JsonLd from '~/components/JsonLd.astro';
import PostCard from '~/components/PostCard.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { crumbsFor } from '~/lib/crumbs';
import { getPublishedPosts, sortByDateDesc, tagCounts } from '~/lib/posts';
import {
  buildBreadcrumbs,
  buildCollectionPage,
  buildItemListOfBlogPostings,
  buildPageGraph,
  buildWebSite,
} from '~/lib/schema';
import { SITE, pageTitle } from '~/lib/site-config';

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  const counts = tagCounts(posts);
  return Object.keys(counts).map((tag) => {
    const tagPosts = sortByDateDesc(posts.filter((p) => p.data.tags.includes(tag)));
    return { params: { tag }, props: { tag, posts: tagPosts, count: counts[tag] ?? 0 } };
  });
}) satisfies GetStaticPaths;

const { tag, posts, count } = Astro.props;
const noindex = count < 3;

const itemListId = `${SITE.url}${Astro.url.pathname}#list`;
const crumbs = crumbsFor(Astro.url.pathname);
const graph = buildPageGraph([
  buildCollectionPage({
    url: `${SITE.url}${Astro.url.pathname}`,
    name: `Tagged: ${tag}`,
    description: `Posts tagged ${tag}.`,
    itemListId,
  }),
  buildItemListOfBlogPostings({
    id: itemListId,
    posts: posts.map((p) => ({
      url: `${SITE.url}/posts/${p.id}`,
      title: p.data.title,
    })),
  }),
  buildBreadcrumbs(crumbs, SITE.url),
  buildWebSite(),
]);
---
<BaseLayout title={pageTitle(`#${tag}`)} description={`Posts tagged ${tag}.`}>
  <JsonLd slot="head" data={graph} />
  {noindex && <meta name="robots" content="noindex" slot="head" />}
  <Breadcrumbs items={crumbs} />
  <h1 class="page-title">Tag <span class="sep" aria-hidden="true">·</span> {tag} <span class="count">{count}</span></h1>
  {posts.length === 0 ? (
    <p class="empty">No posts under this tag yet.</p>
  ) : (
    <section>
      <h2 class="sr-only">Posts tagged {tag}</h2>
      {posts.map((post, i) => <PostCard post={post} index={i} />)}
    </section>
  )}
</BaseLayout>

<style>
  .page-title {
    font-size: var(--text-2xl);
    letter-spacing: -0.01em;
    line-height: var(--leading-tight);
    margin-bottom: var(--space-6);
  }
  .page-title .sep { color: var(--accent); margin: 0 0.2em; }
  .count {
    color: var(--fg-subtle);
    font-size: var(--text-base);
    font-weight: 400;
    margin-left: 0.4em;
    font-variant-numeric: tabular-nums;
  }
  .empty { color: var(--fg-muted); font-style: italic; padding: var(--space-5) 0; }
</style>
