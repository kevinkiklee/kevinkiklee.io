---
import SeedScene from '~/components/garden/SeedScene.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { pageTitle } from '~/lib/site-config';
---
<BaseLayout title={pageTitle('404')} description="Page not found" noindex={true}>
  <section class="not-found">
    <SeedScene />
    <h1>This page went to seed.</h1>
    <p>The path you followed doesn't grow here anymore.</p>
    <p class="back">
      <a href="/"><span class="ar" aria-hidden="true">←</span> Back to the garden</a>
    </p>
  </section>
</BaseLayout>

<style>
  .not-found { max-width: 600px; }
  .not-found .garden-seedscene { display: block; margin-bottom: var(--space-5); }
  h1 {
    font-size: var(--text-2xl);
    letter-spacing: -0.01em;
    line-height: var(--leading-tight);
    margin-bottom: var(--space-3);
  }
  .back { margin-top: var(--space-5); }
  .back a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .ar { color: var(--accent); margin-right: 0.3em; display: inline-block; transition: transform 180ms var(--ease); }
  @media (hover: hover) and (pointer: fine) {
    a:hover .ar { transform: translateX(-3px); }
  }
</style>
