---
import { getCollection } from 'astro:content';
import JsonLd from '~/components/JsonLd.astro';
import PostCard from '~/components/PostCard.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import SectionTitle from '~/components/SectionTitle.astro';
import HeroCluster from '~/components/garden/HeroCluster.astro';
import Swallow from '~/components/garden/Swallow.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getPublishedPosts, sortByDateDesc } from '~/lib/posts';
import { ENTITY_IDS, buildBlog, buildPageGraph, buildWebSite } from '~/lib/schema';
import { SITE } from '~/lib/site-config';

const posts = sortByDateDesc(await getPublishedPosts()).slice(0, 5);
// Cap on featured-project tiles shown on the home page. The full list lives
// at /projects (linked via the section's "all projects" CTA). Keeping the
// home tile count bounded means a runaway `featured: true` flag in YAML
// can't push the LCP candidate further down the page or bloat above-the-
// fold weight.
const HOME_FEATURED_MAX = 6;
const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
  .slice(0, HOME_FEATURED_MAX);
---
{/* BaseHead appends the SITE.tagline on the home page only, so we pass
    SITE.title (not pageTitle()) and let the head template add the suffix. */}
<BaseLayout
  title={SITE.title}
  description={SITE.description}
>
  <JsonLd slot="head" data={buildPageGraph([
    buildWebSite(),
    buildBlog(),
    { '@id': ENTITY_IDS.person },
  ])} />
  <section class="hero" aria-labelledby="hero-title">
    <Swallow />
    <h1 id="hero-title">Essays on the web platform, written at a walking pace.</h1>
    <p class="hero-sub">
      Developer relations at Chrome. Prerendering, performance, and the parts of the platform
      nobody reads the spec for.
    </p>
    <HeroCluster />
  </section>

  <section aria-labelledby="latest">
    <SectionTitle id="latest" name="latest" allHref="/posts" />
    {posts.map((post, i) => <PostCard post={post} index={i} />)}
  </section>

  {projects.length > 0 && (
    <section aria-labelledby="featured">
      <SectionTitle id="featured" name="featured projects" allHref="/projects" />
      <div class="grid">
        {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .hero { position: relative; margin-top: var(--space-7); overflow-x: clip; }
  .hero h1 {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 400;
    line-height: 1.3;
    max-width: 22ch;
  }
  .hero-sub {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--fg-muted);
    margin-top: var(--space-4);
    max-width: 48ch;
  }
  /* :global() because HeroCluster/Swallow are child components rendering
     their own top-level <span>, which never receives this page's cid. */
  .hero :global(.garden-hero-cluster) { position: absolute; right: var(--space-4); bottom: -6px; }
  .hero :global(.garden-swallow) { position: absolute; left: 0; top: -18px; }
  @media (max-width: 640px) { .hero :global(.garden-hero-cluster) { display: none; } }

  .grid { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
</style>
