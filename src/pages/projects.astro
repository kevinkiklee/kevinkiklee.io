---
import { getCollection } from 'astro:content';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import JsonLd from '~/components/JsonLd.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { crumbsFor } from '~/lib/crumbs';
import {
  buildBreadcrumbs,
  buildCollectionPage,
  buildItemListOfSoftwareSourceCode,
  buildPageGraph,
  buildWebSite,
} from '~/lib/schema';
import { SITE, pageTitle } from '~/lib/site-config';

const projects = (await getCollection('projects')).sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999),
);

const itemListId = `${SITE.url}/projects#list`;
const crumbs = crumbsFor('/projects');
const graph = buildPageGraph([
  buildCollectionPage({
    url: `${SITE.url}/projects`,
    name: 'Projects',
    description: 'Personal and side projects.',
    itemListId,
  }),
  buildItemListOfSoftwareSourceCode({
    id: itemListId,
    projects: projects.map((p) => ({
      name: p.data.name,
      url: p.data.url,
      repoUrl: p.data.repoUrl,
      blurb: p.data.blurb,
      tech: p.data.tech,
    })),
  }),
  buildBreadcrumbs(crumbs, SITE.url),
  buildWebSite(),
]);
---
<BaseLayout title={pageTitle('Projects')} description="Open-source projects and side experiments.">
  <JsonLd slot="head" data={graph} />
  <Breadcrumbs items={crumbs} />
  <h1 class="page-title">Projects</h1>
  {projects.length === 0 ? (
    <p class="empty">No projects featured yet.</p>
  ) : (
    <section>
      <h2 class="sr-only">All projects</h2>
      <div class="grid">
        {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .page-title {
    font-size: var(--text-2xl);
    letter-spacing: -0.01em;
    line-height: var(--leading-tight);
    margin-bottom: var(--space-6);
  }
  .grid { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .empty { color: var(--fg-muted); font-style: italic; padding: var(--space-5) 0; }
</style>
