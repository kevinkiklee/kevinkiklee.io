---
import { getCollection } from 'astro:content';
import ProjectCard from '~/components/ProjectCard.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999),
);
---
<BaseLayout title="Projects · kevinkiklee.io" description="Open-source projects and side experiments.">
  <h1 class="page-title">Projects</h1>
  {projects.length === 0 ? (
    <p class="empty">No projects featured yet.</p>
  ) : (
    <div class="grid">
      {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
    </div>
  )}
</BaseLayout>

<style>
  .page-title {
    font-size: var(--text-2xl);
    letter-spacing: -0.01em;
    line-height: var(--leading-tight);
    margin-bottom: var(--space-6);
  }
  .grid { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .empty { color: var(--fg-muted); font-style: italic; padding: var(--space-5) 0; }
</style>
