---
import BaseLayout from '~/layouts/BaseLayout.astro';

// We deliberately do NOT use `astro-pagefind/components/Search` because it
// bundles `@pagefind/default-ui` (JS + CSS) into the route bundle, pushing
// initial JS for /search to ~94 KB. Instead we lazy-load
// /pagefind/pagefind-ui.{js,css} (which Pagefind emits next to the index)
// via dynamic script + link injection on first focus or idle.
const bundlePath = '/pagefind/';
const uiOptions = { showImages: false, resetStyles: false };
---
<BaseLayout title="Search · kevinkiklee.io" description="Search the archive.">
  <h1 class="page-title">Search</h1>
  <div
    id="search"
    class="pagefind-ui pagefind-uninit"
    data-bundle-path={bundlePath}
    data-ui-options={JSON.stringify(uiOptions)}
  >
    <input
      id="search-bootstrap-input"
      type="search"
      placeholder="search posts…"
      aria-label="Search query"
      autocomplete="off"
      autocorrect="off"
      autocapitalize="off"
      spellcheck="false"
    />
    <p class="bootstrap-hint" data-bootstrap-hint>Ready to search.</p>
  </div>
  <p class="hint">
    Tip: press <kbd>/</kbd> or <kbd>⌘K</kbd> from anywhere on the site to open the quick palette.
  </p>
</BaseLayout>

<style is:global>
  .pagefind-ui {
    /* Defensive: declare both legacy and current Pagefind UI variables.
       Unused vars are harmless; this keeps the search UI monochrome (no blue defaults)
       across Pagefind UI versions. */
    --pagefind-ui-primary: var(--fg);
    --pagefind-ui-text: var(--fg);
    --pagefind-ui-background: var(--bg);
    --pagefind-ui-border: var(--rule);
    --pagefind-ui-tag: var(--code-bg);
    --pagefind-ui-border-radius: 0;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-image-border-radius: 0;
    --pagefind-ui-image-box-ratio: 3 / 2;
    --pagefind-ui-font: var(--font-mono);
    --pagefind-ui-scale: 0.95;
  }
  .pagefind-ui a,
  .pagefind-ui a:hover,
  .pagefind-ui a:focus {
    color: var(--fg);
  }
  /* Bootstrap input shown until the real Pagefind UI mounts. */
  #search-bootstrap-input {
    display: block;
    width: 100%;
    padding: var(--space-3);
    background: transparent;
    color: var(--fg);
    border: 1px solid var(--rule);
    font: inherit;
    font-family: var(--font-mono);
  }
  .pagefind-ui:not(.pagefind-uninit) #search-bootstrap-input,
  .pagefind-ui:not(.pagefind-uninit) [data-bootstrap-hint] {
    display: none;
  }
  [data-bootstrap-hint] {
    color: var(--fg-muted);
    font-size: var(--text-sm);
    margin-top: var(--space-3);
  }
</style>

<style>
  .page-title {
    font-size: var(--text-2xl);
    letter-spacing: -0.01em;
    line-height: var(--leading-tight);
    margin-bottom: var(--space-6);
  }
  .hint {
    color: var(--fg-muted);
    font-size: var(--text-sm);
    margin-top: var(--space-5);
  }
  kbd {
    border: 1px solid var(--rule);
    padding: 0 var(--space-2);
    border-radius: 0;
    font-family: var(--font-mono);
  }
</style>

<script>
  // Lazy-mount Pagefind UI on first focus or after browser idle. Loads the
  // prebuilt /pagefind/pagefind-ui.{js,css} that the Pagefind build emits.
  let mounted = false;
  let mounting = false;

  type PagefindUICtor = new (opts: Record<string, unknown>) => unknown;

  function loadStylesheet(href: string): Promise<void> {
    return new Promise((resolve, reject) => {
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = href;
      link.onload = () => resolve();
      link.onerror = () => reject(new Error(`Failed to load ${href}`));
      document.head.appendChild(link);
    });
  }

  function loadScript(src: string): Promise<void> {
    return new Promise((resolve, reject) => {
      const s = document.createElement('script');
      s.src = src;
      s.onload = () => resolve();
      s.onerror = () => reject(new Error(`Failed to load ${src}`));
      document.head.appendChild(s);
    });
  }

  async function mountPagefindUI() {
    if (mounted || mounting) return;
    mounting = true;
    const el = document.getElementById('search') as HTMLDivElement | null;
    if (!el) return;
    const bundlePath = el.getAttribute('data-bundle-path') ?? '/pagefind/';
    try {
      await Promise.all([
        loadStylesheet(`${bundlePath}pagefind-ui.css`),
        loadScript(`${bundlePath}pagefind-ui.js`),
      ]);
      const PagefindUI = (window as unknown as { PagefindUI?: PagefindUICtor }).PagefindUI;
      if (!PagefindUI) throw new Error('PagefindUI global not found');
      const bootstrap = document.getElementById('search-bootstrap-input') as HTMLInputElement | null;
      const bootstrapValue = bootstrap?.value ?? '';
      const hint = el.querySelector('[data-bootstrap-hint]');
      bootstrap?.remove();
      hint?.remove();
      const opts = JSON.parse(el.getAttribute('data-ui-options') ?? '{}');
      new PagefindUI({ ...opts, element: '#search', bundlePath });
      el.classList.remove('pagefind-uninit');
      mounted = true;
      if (bootstrapValue) {
        requestAnimationFrame(() => {
          const realInput = el.querySelector<HTMLInputElement>('input[type="text"]');
          if (realInput) {
            realInput.value = bootstrapValue;
            realInput.dispatchEvent(new Event('input', { bubbles: true }));
            realInput.focus();
          }
        });
      }
    } catch (err) {
      console.warn('[search] Pagefind UI failed to load:', err);
      const hint = document.querySelector('[data-bootstrap-hint]');
      if (hint) {
        hint.textContent = 'Search index unavailable — try `pnpm build && pnpm preview`.';
      }
      mounting = false;
    }
  }

  document
    .getElementById('search-bootstrap-input')
    ?.addEventListener('focus', mountPagefindUI, { once: true });

  // Or after the page is idle so direct visitors get a working UI before
  // they actually engage. Falls back to setTimeout in browsers without
  // requestIdleCallback (Safari).
  type IdleCb = (cb: () => void, opts?: { timeout: number }) => void;
  const ric = (window as unknown as { requestIdleCallback?: IdleCb }).requestIdleCallback;
  if (typeof ric === 'function') {
    ric(() => void mountPagefindUI(), { timeout: 2500 });
  } else {
    setTimeout(() => void mountPagefindUI(), 1500);
  }
</script>
