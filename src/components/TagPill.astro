---
/**
 * Brutalist tag chip. Renders as an <a> by default (linked to /tags/<slug>);
 * pass `asLink={false}` for a non-interactive label (e.g. on the tag page
 * heading itself, where linking back to the same page would be redundant).
 *
 * Use everywhere a tag pill appears so styling, padding, and the touch hit
 * area stay consistent.
 *
 * Hover/active state uses an inverse-fill: a ::before layer slides out from
 * the right edge (transform: scaleX(0)) revealing the bordered outline
 * beneath. Reads as "pulling the fill out". Both states stay AA-contrast
 * in light + dark themes.
 */
interface Props {
  tag: string;
  asLink?: boolean | undefined;
}
const { tag, asLink = true } = Astro.props;
---
{asLink ? (
  <a href={`/tags/${tag}`} class="pill">{tag}</a>
) : (
  <span class="pill">{tag}</span>
)}

<style>
  .pill {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: transparent;
    color: var(--bg);
    border: 1px solid var(--fg);
    /* Visually compact, but expand the hit area for touch accuracy. The
       negative margin keeps the visual rhythm of the meta line intact. */
    padding: var(--space-2) var(--space-3);
    margin: -2px;
    display: inline-block;
    min-height: 32px;
    line-height: 1.4;
    text-decoration: none;
    transition: color var(--t-fast) var(--ease-out);
  }
  .pill::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--fg);
    transform: scaleX(1);
    transform-origin: right;
    transition: transform var(--t-base) var(--ease-out);
    z-index: -1;
  }
  @media (hover: hover) and (pointer: fine) {
    .pill:hover { color: var(--fg); }
    .pill:hover::before { transform: scaleX(0); }
  }
  .pill:focus-visible { color: var(--fg); }
  .pill:focus-visible::before { transform: scaleX(0); }
  @media (hover: none) {
    .pill:active { color: var(--fg); }
    .pill:active::before { transform: scaleX(0); }
  }
  /* Forced-colors: lean on system Highlight so the inversion still reads.
     The ::before layer is removed (background: transparent on a
     forced-colors surface is treated as no fill anyway). */
  @media (forced-colors: active) {
    .pill {
      background: ButtonFace;
      color: ButtonText;
      border: 1px solid ButtonText;
    }
    .pill::before { display: none; }
    a.pill:hover,
    a.pill:focus-visible {
      background: Highlight;
      color: HighlightText;
    }
  }
</style>
