---
/**
 * Tag metadata link (spec §1.3): accent-colored sans text, standalone
 * outside running prose — underline appears on hover/focus only, never
 * color-only. Renders as an <a> by default (linked to /tags/<slug>); pass
 * `asLink={false}` for a non-interactive label (e.g. on the tag page
 * heading itself, where linking back to the same page would be redundant).
 *
 * Use everywhere a tag appears so styling stays consistent.
 *
 * `--accent` remaps to `LinkText` under forced-colors and to `--fg` under
 * `prefers-contrast: more` (tokens.css) — no per-component override needed.
 */
interface Props {
  tag: string;
  asLink?: boolean | undefined;
}
const { tag, asLink = true } = Astro.props;
---
{asLink ? (
  <a href={`/tags/${tag}`} class="tag">{tag}</a>
) : (
  <span class="tag">{tag}</span>
)}

<style>
  .tag {
    color: var(--accent);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    text-decoration: none;
    /* WCAG 2.5.8 (24 x 24 min target): text-xs at 1.8 line-height renders as
       little as ~22.5px tall. padding-block is invisible (no background/
       border on .tag) but still expands the hit/rendered box, so this is a
       pure tap-target fix, not a visual one. */
    padding-block: 5px;
    /* PostCard stretches its title link's ::after over the whole card
       (see PostCard.astro); raise tags above that layer so they stay their
       own tap target instead of triggering the card link underneath. */
    position: relative;
    z-index: 1;
  }
  a.tag:hover,
  a.tag:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
