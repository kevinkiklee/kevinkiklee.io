---
// Modal listing keyboard shortcuts. Triggered by `?` or by JS calling
// document.getElementById('shortcuts-overlay').showModal().
import GardenPause from './GardenPause.astro';
---
<dialog id="shortcuts-overlay" aria-label="Keyboard shortcuts">
  <form method="dialog" class="frame">
    <header>
      <h2>Keyboard shortcuts</h2>
      <button type="submit" aria-label="Close shortcuts" title="Close (Esc)">
        <span class="ar" aria-hidden="true">→</span> close (Esc)
      </button>
    </header>
    <dl>
      <div><dt><kbd>g</kbd> <kbd>h</kbd></dt><dd>Home</dd></div>
      <div><dt><kbd>g</kbd> <kbd>p</kbd></dt><dd>Posts</dd></div>
      <div><dt><kbd>g</kbd> <kbd>a</kbd></dt><dd>About</dd></div>
      <div><dt><kbd>g</kbd> <kbd>t</kbd></dt><dd>Tags</dd></div>
      <div><dt><kbd>/</kbd> · <kbd>⌘K</kbd></dt><dd>Open search palette</dd></div>
      <div><dt><kbd>?</kbd></dt><dd>Show this overlay</dd></div>
      <div><dt><kbd>Esc</kbd></dt><dd>Close any overlay</dd></div>
      <div><dt>Garden</dt><dd><GardenPause /></dd></div>
    </dl>
  </form>
</dialog>

<style>
  dialog {
    background: var(--panel);
    color: var(--fg);
    border: 1px solid var(--rule-soft);
    padding: 0;
    max-width: min(520px, 92vw);
    width: 100%;
    margin-top: 12vh;
    font-family: var(--font-sans);
  }
  dialog::backdrop {
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(2px);
  }
  @media (prefers-reduced-transparency: reduce) {
    dialog::backdrop {
      backdrop-filter: none;
      background: var(--bg);
    }
  }
  .frame { padding: var(--space-5); }
  header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 1px solid var(--rule);
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-4);
  }
  header h2 {
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: -0.005em;
  }
  header button {
    background: transparent;
    border: 0;
    color: var(--fg-muted);
    font: inherit;
    cursor: pointer;
    transition: color 180ms var(--ease);
  }
  header button:hover, header button:focus-visible { color: var(--fg); }
  header button .ar {
    color: var(--accent);
    font-weight: 700;
    margin-right: 0.2em;
  }
  dl {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
  }
  dl > div {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-3);
    align-items: baseline;
  }
  dt { display: flex; gap: var(--space-2); align-items: baseline; }
  dd { margin: 0; color: var(--fg-muted); }
  kbd {
    border: 1px solid var(--rule);
    padding: 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--bg);
    color: var(--fg);
  }
</style>

<script>
  // Backdrop click-to-close — matches SearchPalette behaviour so users
  // get the same dismiss gesture for every modal on the site. Bound on
  // mousedown so dragging text selection out of the dialog doesn't
  // accidentally close it.
  const dlg = document.getElementById('shortcuts-overlay') as HTMLDialogElement | null;
  dlg?.addEventListener('mousedown', (e) => {
    if (e.target === dlg && dlg.open) dlg.close();
  });
</script>
