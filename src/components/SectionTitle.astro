---
import Sprig from './garden/Sprig.astro';

/*
 * Standard section heading: a letterspaced sans label, a sprig ornament, and
 * an optional "All →" link in the accent colour. Used on home, archive,
 * related-posts, discuss, replies, and any page-level section break.
 *
 * Renders as the heading level the caller asks for (default h2) so the
 * document outline stays semantic. Callers pass a lowercase `name` (e.g.
 * "latest"); the uppercase presentation comes from CSS `text-transform` so
 * the accessible name stays lowercase.
 */
interface Props {
  id?: string | undefined;
  name: string;
  level?: 'h2' | 'h3' | undefined;
  allHref?: string | undefined;
  allLabel?: string | undefined;
}
// `allLabel` stays in Props for API stability (existing callers pass it),
// but the new markup always renders the literal "All →" link text.
const { id, name, level = 'h2', allHref } = Astro.props;
const Tag = level;
---
<Tag class="section-title" id={id}>
  <span class="name">{name}</span>
  <Sprig />
  {allHref && <a class="all" href={allHref}>All →</a>}
</Tag>

<style>
  .section-title {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin: var(--space-7) 0 var(--space-4);
  }
  .section-title .name {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-subtle);
  }
  .section-title .all {
    margin-left: auto;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--accent);
    letter-spacing: 0.04em;
    transition: transform 180ms var(--ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .section-title .all:hover { transform: translateX(2px); }
  }
  /* Mirror the nudge for keyboard users so the "All →" link reads
     as interactive when focused. */
  .section-title .all:focus-visible { transform: translateX(2px); }
</style>
