---
/*
 * Standard section heading: a short rule, a lowercase name, and an optional
 * "→ all" link in the accent colour. Used on home, archive, related-posts,
 * discuss, replies, and any page-level section break.
 *
 * Renders as the heading level the caller asks for (default h2) so the
 * document outline stays semantic.
 */
interface Props {
  id?: string | undefined;
  name: string;
  level?: 'h2' | 'h3' | undefined;
  allHref?: string | undefined;
  allLabel?: string | undefined;
}
const { id, name, level = 'h2', allHref, allLabel } = Astro.props;
const Tag = level;
---
<Tag class="section-title" id={id}>
  <span class="rule" aria-hidden="true"></span>
  <span class="name">{name}</span>
  {allHref && (
    <a class="all" href={allHref}>→ {allLabel ?? `all ${name}`}</a>
  )}
</Tag>

<style>
  .section-title {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: -0.005em;
    text-transform: none;
    margin: var(--space-7) 0 var(--space-4);
  }
  .section-title .rule {
    flex: 0 0 var(--space-5);
    height: 1px;
    background: var(--rule-soft);
    align-self: center;
  }
  .section-title .name { color: var(--fg); }
  .section-title .all {
    margin-left: auto;
    font-size: var(--text-xs);
    color: var(--accent);
    letter-spacing: 0.04em;
    transition: transform 180ms var(--ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .section-title .all:hover { transform: translateX(2px); }
  }
  /* Mirror the nudge for keyboard users so the "→ all posts" link reads
     as interactive when focused. */
  .section-title .all:focus-visible { transform: translateX(2px); }
</style>
