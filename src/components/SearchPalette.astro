---
// Global Cmd-K / "/" search palette.
//
// Implementation notes:
// - Uses a vanilla <dialog> element + manual JS rather than the
//   astro-pagefind <Search> component (which is heavier and ships
//   default Pagefind UI styles we don't want here).
// - Lazy-loads /pagefind/pagefind.js on first use. This file is only
//   generated by `astro build` (via astro-pagefind), so during
//   `astro dev` the import will 404. The palette will still open,
//   but searches will fail silently. That's acceptable: the palette
//   works in `astro preview` and production.
// - The /search route ALSO loads /pagefind/pagefind.js via the
//   <Search> component. The browser caches it; no double download.
---
<dialog id="search-palette" aria-label="Search" aria-keyshortcuts="Meta+K Control+K Slash">
  <form method="dialog" class="palette-frame">
    <div class="bar">
      <span class="prompt" aria-hidden="true">/</span>
      <input
        id="palette-input"
        type="search"
        name="q"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        placeholder="search posts…"
        aria-label="Search query"
      />
      <button type="submit" aria-label="Close search palette" title="Close (Esc)">Esc</button>
    </div>
    <div id="palette-results" class="results" aria-label="Search results"></div>
    <p id="palette-status" class="sr-only" aria-live="polite" aria-atomic="true"></p>
    <p class="palette-hint">
      <kbd>↵</kbd> open · <kbd>Esc</kbd> close · full results: <a href="/search">/search</a>
    </p>
  </form>
</dialog>

<style>
  dialog {
    background: var(--panel);
    color: var(--fg);
    border: 1px solid var(--rule-soft);
    padding: 0;
    max-width: min(680px, 92vw);
    width: 100%;
    margin-top: 10vh;
    font-family: var(--font-sans);
  }
  dialog::backdrop {
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(2px);
  }
  .palette-frame { padding: var(--space-4); }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    border-bottom: 1px solid var(--rule);
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-3);
  }
  .prompt {
    color: var(--accent);
    font-weight: 700;
  }
  input {
    flex: 1;
    background: transparent;
    border: 0;
    outline: 0;
    color: var(--fg);
    font: inherit;
    min-width: 0;
  }
  button {
    background: transparent;
    border: 0;
    color: var(--fg-muted);
    font: inherit;
    cursor: pointer;
  }
  .results {
    min-height: 100px;
    max-height: 60vh;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .results :global(a) {
    display: block;
    padding: var(--space-3);
    border: 1px solid var(--rule-soft);
    color: var(--fg);
    text-decoration: none;
  }
  .results :global(a:hover),
  .results :global(a:focus-visible) {
    border-color: var(--fg);
    outline: 0;
  }
  .results :global(strong) { display: block; margin-bottom: var(--space-2); }
  .results :global(small) { color: var(--fg-muted); }
  .results :global(.empty) {
    color: var(--fg-muted);
    padding: var(--space-3);
    font-style: italic;
  }
  .results :global(.empty .garden-leaf) {
    vertical-align: -3px;
    margin-right: var(--space-2);
  }
  .palette-hint {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule-soft);
    color: var(--fg-muted);
    font-size: var(--text-xs);
  }
  kbd {
    border: 1px solid var(--rule);
    padding: 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  /* Open/close choreography. JS still calls showModal()/close(); these
     rules let the browser interpolate display + overlay across the
     show/hide flip via transition-behavior: allow-discrete.

     @starting-style is required for the closed→open transition to fire
     on first show. Browsers without it (Chrome <117 / Safari <17.4 /
     FF <129, ~5% of visitors) see snap. Graceful degradation. */
  #search-palette {
    opacity: 0;
    transform: translateY(-8px) scale(0.985);
    transition:
      opacity var(--t-base) var(--ease-out),
      transform var(--t-base) var(--ease-spring),
      overlay var(--t-base) allow-discrete,
      display var(--t-base) allow-discrete;
  }
  #search-palette[open] {
    opacity: 1;
    transform: none;
  }
  #search-palette::backdrop {
    background: rgba(0, 0, 0, 0);
    transition:
      background var(--t-base) var(--ease-out),
      overlay var(--t-base) allow-discrete,
      display var(--t-base) allow-discrete;
  }
  #search-palette[open]::backdrop {
    background: rgba(0, 0, 0, 0.45);
  }

  @starting-style {
    #search-palette[open] {
      opacity: 0;
      transform: translateY(-8px) scale(0.985);
    }
    #search-palette[open]::backdrop {
      background: rgba(0, 0, 0, 0);
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    dialog::backdrop {
      backdrop-filter: none;
      background: var(--bg);
    }
  }

  /* Mobile: drop the scale, slide up from bottom edge instead. */
  @media (max-width: 640px) {
    #search-palette {
      position: fixed;
      bottom: 0;
      top: auto;
      left: 0;
      right: 0;
      margin: 0;
      width: 100%;
      max-width: 100%;
      /* When the soft keyboard opens, dvh tracks the visible viewport so the
         dialog never spills under the keyboard. svh fallback for browsers
         without dynamic viewport units. */
      max-height: 80svh;
      max-height: 80dvh;
      overflow-y: auto;
      border-radius: 0;
      border-top: 1px solid var(--rule-soft);
      border-bottom: none;
      transform: translateY(8px);
    }
    /* Recompute results scroll-area within the available dialog height. */
    #search-palette .results { max-height: 50svh; max-height: 50dvh; }
    @starting-style {
      #search-palette[open] {
        transform: translateY(8px);
      }
    }
  }
</style>

<script>
  import { escapeHtml, stripHtmlExceptMark } from '~/lib/escape-html';
  import { safeResultUrl as safeResultUrlLib } from '~/lib/safe-result-url';

  // How long to wait after the last keystroke before firing a search.
  // 120ms is fast enough to feel live but slow enough that a typist
  // doesn't trigger 6 in-flight Pagefind queries while typing "astro".
  const SEARCH_DEBOUNCE_MS = 120;

  // Empty-state copy, shared between the visible result area and the
  // aria-live status region so sighted and screen-reader users hear/see
  // the same message.
  const EMPTY_RESULTS_TEXT = 'Nothing sprouted for that query.';
  // A client script can't render an Astro component, so the leaf glyph is
  // inlined here directly. There is no separate `LeafMarker` component to
  // keep in sync with (it was deleted as dead code — this constant is the
  // canonical source for the empty-state leaf markup); change it in place
  // if the glyph ever needs to change.
  const EMPTY_RESULTS_HTML =
    `<p class="empty"><span class="garden garden-leaf" aria-hidden="true"><svg viewBox="0 0 20 20" width="18" height="18"><path d="M10 17 C10 11 11 7 16 3 M10 17 C10 12 8 8 4 5" fill="none" stroke="var(--garden-ink)" stroke-width="1.2" stroke-linecap="round" opacity="0.6" /></svg></span> ${EMPTY_RESULTS_TEXT}</p>`;

  const dlg = document.getElementById('search-palette') as HTMLDialogElement | null;
  const input = document.getElementById('palette-input') as HTMLInputElement | null;
  const results = document.getElementById('palette-results') as HTMLDivElement | null;
  if (dlg && input && results) {
    type PagefindModule = {
      options: (opts: Record<string, unknown>) => Promise<void>;
      search: (q: string) => Promise<{ results: Array<{ data: () => Promise<PagefindResult> }> }>;
    };
    type PagefindResult = {
      url: string;
      excerpt: string;
      meta: { title?: string };
    };

    let pagefindLoaded: PagefindModule | null = null;
    let pagefindLoadFailed = false;

    // Pagefind indexes URLs from our own crawl, so every legitimate value
    // here is a same-origin path. The lib version exists so we can unit-
    // test it with hostile fixtures (javascript:, data:, cross-origin).
    const safeResultUrl = (raw: string) => safeResultUrlLib(raw, window.location.origin);

    let opener: HTMLElement | null = null;

    function open() {
      opener = (document.activeElement instanceof HTMLElement && document.activeElement !== document.body)
        ? document.activeElement
        : null;
      if (!dlg!.open) dlg!.showModal();
      // Defer focus so Safari/Firefox don't fight the dialog open animation.
      setTimeout(() => input!.focus(), 0);
      void loadPagefind();
    }
    function close() { if (dlg!.open) dlg!.close(); }

    dlg.addEventListener('close', () => {
      // `opener` may have been detached from the DOM during a ClientRouter
      // swap. document.contains() guards against focusing an orphan node,
      // which silently fails on most browsers but leaves keyboard users
      // stranded at <body>. Fall through to main, then body as last resort.
      const safeOpener = opener && document.contains(opener) ? opener : null;
      const target =
        safeOpener ?? (document.getElementById('main') as HTMLElement | null) ?? document.body;
      target?.focus({ preventScroll: true });
      opener = null;
    });

    async function loadPagefind(): Promise<PagefindModule | null> {
      if (pagefindLoaded) return pagefindLoaded;
      if (pagefindLoadFailed) return null;
      try {
        // Pagefind index is only generated in production builds.
        // In `astro dev` this 404s and we render an "unavailable in dev" hint.
        // The URL is built at runtime to prevent Vite from statically resolving
        // the import at transform time (which would surface as a dev-overlay error).
        const pagefindUrl = `${window.location.origin}/pagefind/pagefind.js`;
        const mod = (await import(/* @vite-ignore */ pagefindUrl)) as PagefindModule;
        await mod.options({ baseUrl: '/' });
        pagefindLoaded = mod;
        return mod;
      } catch (err) {
        pagefindLoadFailed = true;
        results!.innerHTML =
          '<p class="empty">Search index unavailable in dev. Run <code>pnpm build &amp;&amp; pnpm preview</code>.</p>';
        console.warn('[SearchPalette] Pagefind not available:', err);
        return null;
      }
    }

    let timer: number | undefined;
    input.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(async () => {
        const pf = await loadPagefind();
        if (!pf) return;
        const q = input!.value.trim();
        if (!q) {
          results!.innerHTML = '';
          document.getElementById('palette-status')!.textContent = '';
          return;
        }
        const search = await pf.search(q);
        if (search.results.length === 0) {
          results!.innerHTML = EMPTY_RESULTS_HTML;
          document.getElementById('palette-status')!.textContent = EMPTY_RESULTS_TEXT;
          return;
        }
        const top = await Promise.all(
          search.results.slice(0, 8).map((r) => r.data()),
        );
        const safeRows = top
          .map((d) => {
            const href = safeResultUrl(d.url);
            if (!href) return null;
            const title = escapeHtml(d.meta.title ?? href);
            const url = escapeHtml(href);
            const excerpt = stripHtmlExceptMark(d.excerpt);
            return `<li><a href="${url}" aria-label="Open: ${title}"><strong>${title}</strong><small>${excerpt}</small></a></li>`;
          })
          .filter((r): r is string => r !== null);
        if (safeRows.length === 0) {
          results!.innerHTML = EMPTY_RESULTS_HTML;
          document.getElementById('palette-status')!.textContent = EMPTY_RESULTS_TEXT;
          return;
        }
        results!.innerHTML = `<ul role="list">${safeRows.join('')}</ul>`;
        document.getElementById('palette-status')!.textContent =
          `${safeRows.length} result${safeRows.length === 1 ? '' : 's'} for ${q}`;
      }, SEARCH_DEBOUNCE_MS);
    });

    document.addEventListener('keydown', (e) => {
      const k = e.key.toLowerCase();
      const tag = (document.activeElement as HTMLElement | null)?.tagName;
      const typingInField = tag === 'INPUT' || tag === 'TEXTAREA' || (document.activeElement as HTMLElement | null)?.isContentEditable;
      if ((e.metaKey || e.ctrlKey) && k === 'k') {
        e.preventDefault();
        open();
      } else if (k === '/' && !typingInField) {
        e.preventDefault();
        open();
      } else if (e.key === 'Escape' && dlg!.open) {
        close();
      }
    });

    // Close palette after navigation via result link click.
    results.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (target?.closest('a')) close();
    });

    // Click outside the form (i.e. on the dialog's own padding/backdrop)
    // closes the palette. We bind on `mousedown` so dragging text selection
    // out of the form doesn't accidentally close it.
    dlg.addEventListener('mousedown', (e) => {
      if (e.target === dlg) close();
    });

    // Test/audit hook: ?palette=open opens the palette on load.
    // Used by `audit-routes.ts` `search-palette` entry. Removed from URL after open
    // so subsequent navigation isn't sticky.
    if (new URLSearchParams(window.location.search).get('palette') === 'open') {
      open();
      history.replaceState(null, '', window.location.pathname);
    }
  }
</script>
