---
// Global Cmd-K / "/" search palette.
//
// Implementation notes:
// - Uses a vanilla <dialog> element + manual JS rather than the
//   astro-pagefind <Search> component (which is heavier and ships
//   default Pagefind UI styles we don't want here).
// - Lazy-loads /pagefind/pagefind.js on first use. This file is only
//   generated by `astro build` (via astro-pagefind), so during
//   `astro dev` the import will 404. The palette will still open,
//   but searches will fail silently. That's acceptable: the palette
//   works in `astro preview` and production.
// - The /search route ALSO loads /pagefind/pagefind.js via the
//   <Search> component. The browser caches it; no double download.
---
<dialog id="search-palette" aria-label="Search" aria-keyshortcuts="Meta+K Slash">
  <form method="dialog" class="palette-frame">
    <div class="bar">
      <span class="prompt" aria-hidden="true">/</span>
      <input
        id="palette-input"
        type="search"
        name="q"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        placeholder="search posts…"
        aria-label="Search query"
      />
      <button type="submit" aria-label="Close search palette" title="Close (Esc)">[ESC]</button>
    </div>
    <div id="palette-results" class="results" aria-label="Search results"></div>
    <p class="palette-hint">
      <kbd>↵</kbd> open · <kbd>Esc</kbd> close · full results: <a href="/search">/search</a>
    </p>
  </form>
</dialog>

<style>
  dialog {
    background: var(--bg);
    color: var(--fg);
    border: 2px solid var(--rule);
    padding: 0;
    max-width: min(680px, 92vw);
    width: 100%;
    margin-top: 10vh;
    font-family: var(--font-mono);
  }
  dialog::backdrop {
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(2px);
  }
  .palette-frame { padding: var(--space-4); }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    border-bottom: 1px solid var(--rule);
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-3);
  }
  .prompt {
    color: var(--fg-muted);
    font-weight: 700;
  }
  input {
    flex: 1;
    background: transparent;
    border: 0;
    outline: 0;
    color: var(--fg);
    font: inherit;
    min-width: 0;
  }
  button {
    background: transparent;
    border: 0;
    color: var(--fg-muted);
    font: inherit;
    cursor: pointer;
  }
  .results {
    min-height: 100px;
    max-height: 60vh;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .results :global(a) {
    display: block;
    padding: var(--space-3);
    border: 1px solid var(--rule-soft);
    color: var(--fg);
    text-decoration: none;
  }
  .results :global(a:hover),
  .results :global(a:focus-visible) {
    border-color: var(--fg);
    outline: 0;
  }
  .results :global(strong) { display: block; margin-bottom: var(--space-2); }
  .results :global(small) { color: var(--fg-muted); }
  .results :global(.empty) {
    color: var(--fg-muted);
    padding: var(--space-3);
    font-style: italic;
  }
  .palette-hint {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule-soft);
    color: var(--fg-muted);
    font-size: var(--text-xs);
  }
  kbd {
    border: 1px solid var(--rule);
    padding: 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
</style>

<script>
  const dlg = document.getElementById('search-palette') as HTMLDialogElement | null;
  const input = document.getElementById('palette-input') as HTMLInputElement | null;
  const results = document.getElementById('palette-results') as HTMLDivElement | null;
  if (dlg && input && results) {
    type PagefindModule = {
      options: (opts: Record<string, unknown>) => Promise<void>;
      search: (q: string) => Promise<{ results: Array<{ data: () => Promise<PagefindResult> }> }>;
    };
    type PagefindResult = {
      url: string;
      excerpt: string;
      meta: { title?: string };
    };

    let pagefindLoaded: PagefindModule | null = null;
    let pagefindLoadFailed = false;

    function open() {
      if (!dlg!.open) dlg!.showModal();
      // Defer focus so Safari/Firefox don't fight the dialog open animation.
      setTimeout(() => input!.focus(), 0);
      void loadPagefind();
    }
    function close() { if (dlg!.open) dlg!.close(); }

    async function loadPagefind(): Promise<PagefindModule | null> {
      if (pagefindLoaded) return pagefindLoaded;
      if (pagefindLoadFailed) return null;
      try {
        // Pagefind index is only generated in production builds.
        // In `astro dev` this 404s and we render an "unavailable in dev" hint.
        // @ts-expect-error /pagefind/pagefind.js is generated at build time by astro-pagefind.
        const mod = (await import(/* @vite-ignore */ '/pagefind/pagefind.js')) as PagefindModule;
        await mod.options({ baseUrl: '/' });
        pagefindLoaded = mod;
        return mod;
      } catch (err) {
        pagefindLoadFailed = true;
        results!.innerHTML =
          '<p class="empty">Search index unavailable in dev. Run <code>pnpm build &amp;&amp; pnpm preview</code>.</p>';
        console.warn('[SearchPalette] Pagefind not available:', err);
        return null;
      }
    }

    function escapeHtml(s: string): string {
      return s
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    let timer: number | undefined;
    input.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(async () => {
        const pf = await loadPagefind();
        if (!pf) return;
        const q = input!.value.trim();
        if (!q) {
          results!.innerHTML = '';
          return;
        }
        const search = await pf.search(q);
        if (search.results.length === 0) {
          results!.innerHTML = '<p class="empty">No results.</p>';
          return;
        }
        const top = await Promise.all(
          search.results.slice(0, 8).map((r) => r.data()),
        );
        results!.innerHTML = top
          .map((d) => {
            const title = escapeHtml(d.meta.title ?? d.url);
            const url = escapeHtml(d.url);
            // Pagefind returns excerpts pre-wrapped with <mark> highlighting.
            // We deliberately don't escape `excerpt` to preserve those marks.
            return `<a href="${url}" aria-label="Open: ${title}"><strong>${title}</strong><small>${d.excerpt}</small></a>`;
          })
          .join('');
      }, 120);
    });

    document.addEventListener('keydown', (e) => {
      const k = e.key.toLowerCase();
      const tag = (document.activeElement as HTMLElement | null)?.tagName;
      const typingInField = tag === 'INPUT' || tag === 'TEXTAREA' || (document.activeElement as HTMLElement | null)?.isContentEditable;
      if ((e.metaKey || e.ctrlKey) && k === 'k') {
        e.preventDefault();
        open();
      } else if (k === '/' && !typingInField) {
        e.preventDefault();
        open();
      } else if (e.key === 'Escape' && dlg!.open) {
        close();
      }
    });

    // Close palette after navigation via result link click.
    results.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (target?.closest('a')) close();
    });

    // Click outside the form (i.e. on the dialog's own padding/backdrop)
    // closes the palette. We bind on `mousedown` so dragging text selection
    // out of the form doesn't accidentally close it.
    dlg.addEventListener('mousedown', (e) => {
      if (e.target === dlg) close();
    });
  }
</script>
