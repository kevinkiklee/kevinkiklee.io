---
import { MASTODON_INSTANCE_URL, TWITTER_HANDLE } from 'astro:env/client';
import { SITE } from '~/lib/site-config';

interface Props {
  title: string;
  description: string;
  canonical?: string | undefined;
  ogType?: 'website' | 'article' | undefined;
  ogImageUrl?: string | undefined;
  publishedTime?: Date | undefined;
  modifiedTime?: Date | undefined;
  tags?: string[] | undefined;
  lcpImage?:
    | { sizes: string; avifSrcset?: string | undefined; webpSrcset?: string | undefined }
    | undefined;
}
const {
  title,
  description,
  canonical: canonicalProp,
  ogType = 'website',
  ogImageUrl,
  publishedTime,
  modifiedTime,
  tags = [],
  lcpImage,
} = Astro.props;

const canonical = canonicalProp ?? new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = ogImageUrl ?? new URL('/og-default.png', Astro.site).toString();
const mastodonProfile = MASTODON_INSTANCE_URL ?? SITE.defaultMastodon;
// Home title gets the tagline appended; everything else uses the title as-is.
const isHome = Astro.url.pathname === '/';
const finalTitle = isHome ? `${title} — ${SITE.tagline}` : title;
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

<!-- Critical preload: font dispatched before <title> so the browser preload
     scanner picks it up immediately. Same-origin font; `crossorigin` is
     required to match the CSS-triggered fetch. -->
<link rel="preload" as="font" type="font/woff2" href="/fonts/jetbrains-mono.woff2" crossorigin />

<title>{finalTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content="kevinkiklee.io" />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{TWITTER_HANDLE && <meta name="twitter:site" content={TWITTER_HANDLE} />}
{TWITTER_HANDLE && <meta name="twitter:creator" content={TWITTER_HANDLE} />}

{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{ogType === 'article' && <meta property="article:author" content="Kevin Lee" />}
{ogType === 'article' && tags[0] && <meta property="article:section" content={tags[0]} />}
{tags.map((t) => <meta property="article:tag" content={t} />)}

<link rel="alternate" type="application/rss+xml" href="/rss.xml" title="kevinkiklee.io" />
<link rel="alternate" type="application/feed+json" href="/feed.json" title="kevinkiklee.io" />
<link rel="me" href={mastodonProfile} />
<link rel="webmention" href="https://webmention.io/kevinkiklee.io/webmention" />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
<link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
<link rel="apple-touch-icon" sizes="192x192" href="/favicon-192.png" />
<meta name="apple-mobile-web-app-title" content="kevinkiklee" />
<link rel="manifest" href="/manifest.webmanifest" />

{lcpImage?.avifSrcset && (
  <link
    rel="preload"
    as="image"
    type="image/avif"
    fetchpriority="high"
    imagesrcset={lcpImage.avifSrcset}
    imagesizes={lcpImage.sizes}
  />
)}
{lcpImage?.webpSrcset && (
  <link
    rel="preload"
    as="image"
    type="image/webp"
    fetchpriority="high"
    imagesrcset={lcpImage.webpSrcset}
    imagesizes={lcpImage.sizes}
  />
)}
