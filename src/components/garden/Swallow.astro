---
interface Props {
  // When true, renders the bird without the `garden-fly` animation class
  // (no flight path, no one-shot entrance) — for callers that just want
  // the static bird glyph reused in place, e.g. tags/index.astro's pair.
  static?: boolean;
}
const { static: isStatic = false } = Astro.props;
---
<span class="garden garden-swallow" aria-hidden="true">
  <svg class={isStatic ? undefined : 'garden-fly'} viewBox="0 0 40 20" width="26" height="13">
    <path d="M2 13 C8 5 14 5 20 11 C26 5 32 5 38 13 M20 11 L20 14"
      fill="none" stroke="var(--garden-ink)" stroke-width="1.2" stroke-linecap="round" />
  </svg>
</span>
