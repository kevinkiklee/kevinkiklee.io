---
// PostBodyReveal.astro
//
// Mounts a single script element that runs the reveal sequence on every
// astro:after-swap that lands on a post page. Skipped on first paint
// (LCP candidate paints immediately, gated by [data-firstPaint] flag
// set in BaseLayout).
//
// Sequence (durations sourced from scaledDuration):
//   0ms    .eyebrow fades in
//   90ms   .post h1 fades up  (skipped: data-no-anim on h1)
//   280ms  .meta-rail fades in
//   380ms  .prose > *:first-child fades up
// Total elapsed: ≤ 800ms.
---
<script>
  import { scaledDuration, withWillChange, EASE_OUT } from '~/lib/motion';

  type Kind = 'fade' | 'fade-up';

  function getKeyframes(kind: Kind): Keyframe[] {
    if (kind === 'fade-up') {
      return [
        { opacity: 0, transform: 'translateY(8px)' },
        { opacity: 1, transform: 'none' },
      ];
    }
    return [{ opacity: 0 }, { opacity: 1 }];
  }

  function isPostPage(): boolean {
    return /^\/posts\/(?!page\/)[^/]+\/?$/.test(location.pathname);
  }

  // Track in-flight rAF ids so a fast back-nav can cancel them before they
  // dispatch animations against soon-to-be-removed DOM nodes. Listener is
  // bound once; the ids list is mutated in place across reveal sequences.
  const pendingRafIds: number[] = [];
  function cancelPendingRafs() {
    while (pendingRafIds.length) {
      const id = pendingRafIds.pop();
      if (id !== undefined) cancelAnimationFrame(id);
    }
  }
  document.addEventListener('astro:before-swap', cancelPendingRafs);

  function runPostRevealSequence(): void {
    if (document.visibilityState !== 'visible') return;
    const dur = scaledDuration(180);
    // Scale stagger delays in lockstep with the duration: when scaledDuration
    // collapses to 1ms (reduce-motion / save-data / 2G), the staggered
    // delays would otherwise still wait their full 90/280/380ms and produce
    // a stuttery pseudo-animation. Ratio keeps the choreography proportional.
    const scale = dur / 180;
    const seq: Array<{ sel: string; delay: number; kind: Kind }> = [
      { sel: '.eyebrow',                     delay: 0,                          kind: 'fade' },
      { sel: '.post h1',                    delay: Math.round(90 * scale),     kind: 'fade-up' },
      { sel: '.meta-rail',                  delay: Math.round(280 * scale),    kind: 'fade' },
      { sel: '.prose > *:first-child',      delay: Math.round(380 * scale),    kind: 'fade-up' },
    ];
    for (const { sel, delay, kind } of seq) {
      const el = document.querySelector(sel) as HTMLElement | null;
      if (!el) continue;
      if (el.hasAttribute('data-no-anim')) continue;
      const rafId = requestAnimationFrame(() => {
        void withWillChange(el, ['opacity', 'transform'], () =>
          el.animate(getKeyframes(kind), {
            duration: dur,
            delay,
            easing: EASE_OUT,
            fill: 'both',
          }).finished,
        );
      });
      pendingRafIds.push(rafId);
    }
  }

  function onAfterSwap() {
    if (document.documentElement.dataset.firstPaint === '1') {
      delete document.documentElement.dataset.firstPaint;
      return;
    }
    if (!isPostPage()) return;
    runPostRevealSequence();
  }

  document.addEventListener('astro:after-swap', onAfterSwap);
</script>
