---
// Global key handler. Wires `g <key>` chords to navigation and `?` to the
// shortcuts overlay. The overlay itself lives in <ShortcutsOverlay/>; this
// component is purely the listener.
---
<script>
  // Map of `g`-chord destinations. Updating routes here and in
  // ShortcutsOverlay is the only place to keep in sync.
  const ROUTES: Record<string, string> = {
    h: '/',
    p: '/posts',
    a: '/about',
    t: '/tags',
  };

  function isTypingTarget(target: EventTarget | null): boolean {
    if (!(target instanceof HTMLElement)) return false;
    const tag = target.tagName;
    if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return true;
    if (target.isContentEditable) return true;
    return false;
  }

  // Astro `navigate()` triggers a ClientRouter swap (with view transitions)
  // instead of a full document reload. Imported async so the chord handler
  // doesn't block initial parse; on environments without ClientRouter the
  // module would still resolve safely. `location.assign` is the fallback path
  // if the import ever fails (extremely defensive — keeps `g h` working even
  // under a chunk-loading failure).
  type NavFn = (href: string, opts?: { history?: 'auto' | 'push' | 'replace' }) => void;
  let cachedNavigate: NavFn | null = null;
  async function resolveNavigate(): Promise<NavFn> {
    if (cachedNavigate) return cachedNavigate;
    try {
      const mod = (await import('astro:transitions/client')) as { navigate?: NavFn };
      if (typeof mod.navigate === 'function') {
        cachedNavigate = mod.navigate;
        return mod.navigate;
      }
    } catch {
      // Fall through to assign.
    }
    cachedNavigate = (href) => window.location.assign(href);
    return cachedNavigate;
  }

  // Idempotent: this script may be inlined into multiple route bundles.
  // `__kbInit` is declared on `Window` in `src/env.d.ts`.
  if (!window.__kbInit) {
    window.__kbInit = true;

    let chordPrefix: 'g' | null = null;
    let chordTimer: number | undefined;

    function clearChord() {
      chordPrefix = null;
      window.clearTimeout(chordTimer);
    }

    document.addEventListener('keydown', (e) => {
      // Never intercept while the user is typing in a field.
      if (isTypingTarget(e.target)) return;
      // Ignore when modifier keys other than shift are held; shift is okay
      // because `?` requires it on US keyboards.
      if (e.metaKey || e.ctrlKey || e.altKey) return;

      const k = e.key.toLowerCase();

      // `?` opens the shortcuts overlay.
      if (e.key === '?' || (e.shiftKey && k === '/')) {
        const dlg = document.getElementById('shortcuts-overlay') as HTMLDialogElement | null;
        if (dlg && !dlg.open) {
          e.preventDefault();
          const shortcutsOpener = (document.activeElement instanceof HTMLElement && document.activeElement !== document.body)
            ? document.activeElement
            : null;
          dlg.showModal();
          dlg.addEventListener('close', () => {
            // Opener may have been detached by a ClientRouter swap while the
            // dialog was open. Guard with document.contains so we fall
            // through to #main rather than focus an orphan node.
            const safeOpener = shortcutsOpener && document.contains(shortcutsOpener) ? shortcutsOpener : null;
            const target =
              safeOpener ?? (document.getElementById('main') as HTMLElement | null) ?? document.body;
            target?.focus({ preventScroll: true });
          }, { once: true });
        }
        clearChord();
        return;
      }

      if (chordPrefix === 'g') {
        const dest = ROUTES[k];
        if (dest) {
          e.preventDefault();
          void resolveNavigate().then((nav) => nav(dest));
        }
        clearChord();
        return;
      }

      if (k === 'g') {
        chordPrefix = 'g';
        chordTimer = window.setTimeout(clearChord, 1500);
      }
    });
  }
</script>
