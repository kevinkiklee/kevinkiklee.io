---
/**
 * Code-block copy button.
 *
 * Mounted once globally in BaseLayout. The script listens for the
 * `astro:page-load` event (which fires on initial load AND after every
 * ClientRouter swap) and walks every `.prose pre` to attach a button.
 * The `if (pre.querySelector('.copy-btn')) return;` guard makes the
 * walk idempotent.
 *
 * Success path uses a 200ms spring scale (peak 1.08 at offset 0.4) via
 * WAAPI so the button "punches" briefly. Reduced-motion / Save-Data
 * collapse the duration to 1ms (invisible), text-only feedback remains.
 */
---
<script>
  import { scaledDuration, withWillChange, EASE_SPRING } from '~/lib/motion';

  type AnyPre = HTMLPreElement;

  // Track all in-flight label-reset timers across button instances so a
  // ClientRouter swap that yanks the <pre> out of the DOM doesn't leave
  // orphaned timers firing against a detached button.
  const pendingResetTimers = new Set<number>();
  function clearAllResetTimers() {
    for (const id of pendingResetTimers) window.clearTimeout(id);
    pendingResetTimers.clear();
  }
  document.addEventListener('astro:before-swap', clearAllResetTimers);

  function attach(): void {
    document.querySelectorAll<AnyPre>('.prose pre').forEach((pre) => {
      if (pre.querySelector('.copy-btn')) return;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'copy-btn';
      btn.textContent = 'copy';
      // Keep aria-label static so AT announces the control name, not transient
      // state. The live announcement comes from the sibling status span below.
      btn.setAttribute('aria-label', 'Copy code');

      // Dedicated sr-only live region for AT announcements (P11). Placing
      // aria-live on the <button> itself causes some AT to re-read the entire
      // control name on every mutation; a sibling span isolates the signal.
      const status = document.createElement('span');
      status.className = 'sr-only';
      status.setAttribute('aria-live', 'polite');
      status.setAttribute('aria-atomic', 'true');

      // Track the in-flight reset timer so spam-clicks don't pile up
      // multiple `setTimeout`s and produce flickering label changes.
      let resetTimer: number | undefined;
      btn.addEventListener('click', async () => {
        const code = pre.querySelector('code')?.textContent ?? '';
        let ok = false;
        try {
          await navigator.clipboard.writeText(code);
          ok = true;
        } catch {
          // Swallow — we'll surface the error via the button text below.
        }
        if (!ok) {
          btn.textContent = 'error';
          status.textContent = 'Failed to copy';
          if (resetTimer !== undefined) {
            window.clearTimeout(resetTimer);
            pendingResetTimers.delete(resetTimer);
          }
          resetTimer = window.setTimeout(() => {
            btn.textContent = 'copy';
            status.textContent = '';
            if (resetTimer !== undefined) pendingResetTimers.delete(resetTimer);
            resetTimer = undefined;
          }, 1200);
          pendingResetTimers.add(resetTimer);
          return;
        }
        await withWillChange(btn, ['transform'], () =>
          btn.animate(
            [
              { transform: 'scale(1)' },
              { transform: 'scale(1.08)', offset: 0.4 },
              { transform: 'scale(1)' },
            ],
            { duration: scaledDuration(200), easing: EASE_SPRING, fill: 'both' },
          ).finished,
        );
        btn.textContent = '✓ copied';
        status.textContent = 'Copied';
        if (resetTimer !== undefined) {
          window.clearTimeout(resetTimer);
          pendingResetTimers.delete(resetTimer);
        }
        resetTimer = window.setTimeout(() => {
          btn.textContent = 'copy';
          status.textContent = '';
          if (resetTimer !== undefined) pendingResetTimers.delete(resetTimer);
          resetTimer = undefined;
        }, 1000);
        pendingResetTimers.add(resetTimer);
      });
      pre.style.position = 'relative';
      pre.appendChild(btn);
      // Insert status span after the button — same pre parent, invisible to
      // sighted users but picked up by the live-region announcement pipeline.
      pre.appendChild(status);
    });
  }

  document.addEventListener('astro:page-load', attach);
</script>
