---
import SectionTitle from './SectionTitle.astro';
import Webmentions from './Webmentions.astro';

interface Props {
  postUrl: string;
  postTitle: string;
  mastodonUrl?: string | undefined;
}
const { postUrl, postTitle, mastodonUrl } = Astro.props;

const shareText = `"${postTitle}" — ${postUrl}`;
const elkShare = `https://elk.zone/intent/post?text=${encodeURIComponent(shareText)}`;
const blueskyShare = `https://bsky.app/intent/compose?text=${encodeURIComponent(shareText)}`;
---
<aside class="discuss" aria-labelledby="discuss-h">
  <SectionTitle id="discuss-h" name="discuss" />
  {/* All three targets are off-site (mastodon/elk, bsky). `noopener noreferrer`
      prevents `window.opener` leakage on user-initiated new-tab opens
      (cmd-click / middle-click) and suppresses the Referer header so the
      destination can't see which post the share came from. */}
  <ul role="list" class="links">
    {mastodonUrl ? (
      <li><a href={mastodonUrl} rel="noopener noreferrer"><span class="ar" aria-hidden="true">→</span> reply on mastodon</a></li>
    ) : (
      <li><a href={elkShare} rel="noopener noreferrer"><span class="ar" aria-hidden="true">→</span> start a thread on mastodon</a></li>
    )}
    <li><a href={blueskyShare} rel="noopener noreferrer"><span class="ar" aria-hidden="true">→</span> share on bluesky</a></li>
  </ul>

  <Webmentions url={postUrl} />
</aside>

<style>
  .discuss {
    margin-top: var(--space-7);
    border-top: 2px solid var(--rule);
    padding-top: var(--space-5);
  }
  .links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .links li { padding: var(--space-3) 0; }
  .links a {
    color: var(--fg-muted);
    transition: color 180ms var(--ease);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .links a:hover,
  .links a:focus-visible { color: var(--fg); }
  .links .ar {
    color: var(--accent);
    font-weight: 700;
    margin-right: 0.3em;
    display: inline-block;
    transition: transform 180ms var(--ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .links a:hover .ar { transform: translateX(3px); }
  }
  @media (max-width: 640px) {
    /* Full-width tap target on phones — feels like a button, not a link. */
    .links a {
      display: flex;
      align-items: center;
      width: 100%;
      border: 1px solid var(--rule-soft);
      padding: var(--space-3) var(--space-4);
    }
  }
</style>
