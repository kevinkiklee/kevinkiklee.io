---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: number | undefined;
}
const { project, index = 0 } = Astro.props;
const { name, blurb, url, repoUrl, tech } = project.data;
---
<article class="project-card reveal" style={`--i:${index}`}>
  <h3>
    {/* `noopener noreferrer` is defense-in-depth even without target=_blank:
        a future change that adds new-tab behaviour (or a user's middle-click /
        cmd-click) won't leak `window.opener` to the project's site, and the
        Referer header is suppressed so log analytics on the destination can't
        attribute the click back to a specific kevinkiklee.io route. */}
    <a href={url} rel="noopener noreferrer">
      <span class="marker" aria-hidden="true"></span><span class="title">{name}</span>
      <span class="ext" aria-hidden="true">↗</span>
    </a>
  </h3>
  <p>{blurb}</p>
  {tech.length > 0 && (
    <ul role="list" class="tech" aria-label={`${name} tech stack`}>
      {tech.map((t) => <li>{t}</li>)}
    </ul>
  )}
  {repoUrl && (
    <a href={repoUrl} class="repo" rel="noopener noreferrer" aria-label={`View ${name} repository`}>
      view repo →
    </a>
  )}
</article>

<style>
  .project-card {
    border: 1px solid var(--rule-soft);
    padding: var(--space-4);
    contain: layout paint;
    transition: border-color 180ms var(--ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .project-card:hover { border-color: var(--rule); }
    .project-card:hover .ext,
    .project-card:hover .repo { color: var(--accent); }
    .project-card:hover .ext { transform: translate(2px, -2px); }
  }
  /* Mirror hover affordance for keyboard users. :focus-within lights up the
     same ext/repo accent when any descendant link is focused — the global
     focus ring stays the primary indicator; this is a polish cue. */
  .project-card:focus-within { border-color: var(--rule); }
  .project-card:focus-within .ext,
  .project-card:focus-within .repo { color: var(--accent); }
  .project-card:focus-within .ext { transform: translate(2px, -2px); }
  h3 {
    font-size: var(--text-base);
    letter-spacing: -0.005em;
    line-height: var(--leading-tight);
  }
  h3 a {
    display: flex;
    align-items: baseline;
    gap: 0.4em;
  }
  /* Same CSS triangle as PostCard — kept in sync visually. */
  .marker {
    flex: 0 0 auto;
    width: 0;
    height: 0;
    border-left: 0.45em solid var(--accent);
    border-top: 0.32em solid transparent;
    border-bottom: 0.32em solid transparent;
    transform: translateY(-0.05em);
  }
  .title { flex: 1 1 auto; }
  .ext {
    flex: 0 0 auto;
    color: var(--fg-subtle);
    transition:
      color 180ms var(--ease),
      transform 180ms var(--ease);
  }
  p { color: var(--fg-muted); margin: var(--space-3) 0; }
  .tech { display: flex; gap: var(--space-2); flex-wrap: wrap; font-size: var(--text-xs); color: var(--fg-subtle); }
  .tech li::before { content: '['; }
  .tech li::after { content: ']'; }
  .repo {
    display: inline-block;
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--fg-muted);
    transition: color 180ms var(--ease);
  }
</style>
