---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  variant?: 'inline' | 'aside' | undefined;
}
const { headings, variant = 'aside' } = Astro.props;
// Show only H2/H3. We render a flat list with H3s indented for simplicity
// — nested <ul> would generate noisy markup for short posts.
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
const firstSlug = items[0]?.slug;
---
{items.length > 0 && variant === 'inline' && (
  <details class="toc toc-inline" transition:persist>
    <summary aria-label="Table of contents">
      <span class="toc-prefix">// CONTENTS</span>
      <span class="toc-current" data-current>{items[0]?.text ?? ''}</span>
    </summary>
    <span class="toc-indicator" aria-hidden="true"></span>
    <ol>
      {items.map((h) => (
        <li class:list={[`depth-${h.depth}`]}>
          {/* 'location' is spec-valid for in-page section markers; AT support
              verified acceptable in Phase 1 audit. */}
          <a
            href={`#${h.slug}`}
            aria-current={h.slug === firstSlug ? 'location' : undefined}
          >{h.text}</a>
        </li>
      ))}
    </ol>
  </details>
)}

{items.length > 0 && variant === 'aside' && (
  <aside class="toc toc-aside" aria-label="Table of contents" transition:persist>
    <p class="toc-label">Contents</p>
    <span class="toc-indicator" aria-hidden="true"></span>
    <ol>
      {items.map((h) => (
        <li class:list={[`depth-${h.depth}`]}>
          {/* 'location' is spec-valid for in-page section markers; AT support
              verified acceptable in Phase 1 audit. */}
          <a
            href={`#${h.slug}`}
            aria-current={h.slug === firstSlug ? 'location' : undefined}
          >{h.text}</a>
        </li>
      ))}
    </ol>
  </aside>
)}

<style>
  .toc {
    position: relative;
    contain: layout paint;
    border: 1px solid var(--rule);
    padding: var(--space-4);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  .toc-inline summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: baseline;
    min-height: 44px;
    padding: var(--space-1) 0;
  }
  .toc-inline summary::-webkit-details-marker { display: none; }
  .toc-inline summary::before {
    content: "▸";
    color: var(--fg-subtle);
    margin-right: var(--space-2);
    transition: transform var(--t-base) var(--ease-out);
    display: inline-block;
  }
  .toc-inline[open] summary::before { transform: rotate(90deg); }
  .toc-inline .toc-prefix {
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--fg-subtle);
    text-transform: uppercase;
  }
  .toc-inline .toc-current { color: var(--fg-muted); }
  .toc-inline ol { margin-top: var(--space-3); }

  .toc-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--fg-subtle);
    margin-bottom: var(--space-3);
  }
  .toc ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .toc li.depth-3 { padding-left: var(--space-4); }
  .toc a {
    display: inline-block;
    color: var(--fg-muted);
    padding-left: var(--space-2);
    margin-left: calc(-1 * var(--space-2));
    transition: color var(--t-fast) var(--ease-out);
  }
  .toc a:hover, .toc a:focus-visible { color: var(--fg); }
  /* Active heading: weight bump + colour swap. The compositor-rendered
     indicator bar (below) is the primary signal; the weight + colour
     keep the active item readable in forced-colors / colour-blind cases. */
  .toc a[aria-current='location'],
  .toc a.is-active {
    color: var(--fg);
    font-weight: 600;
  }

  /* Active-section indicator: a 2px bar that glides between items via
     transform: translateY(N) scaleY(R) where R = item-height / base-height.
     Fully compositor (no height animation, no layout reflow). */
  .toc-indicator {
    position: absolute;
    /* Align with the inner edge of the .toc padding so the bar reads
       as a left-rail mark next to the link text. The inline variant's
       bar sits below the summary row (where the <ol> starts when open). */
    top: var(--space-4);
    left: var(--space-4);
    width: 2px;
    height: 1.4em;
    background: var(--accent);
    transform-origin: top left;
    transform: translateY(0) scaleY(0);
    transition: transform var(--t-base) var(--ease-out);
    pointer-events: none;
  }

  @media (min-width: 1024px) {
    .toc-aside {
      position: sticky;
      top: var(--space-6);
      max-height: calc(100dvh - var(--space-7));
      overflow-y: auto;
      /* Re-establish positioning for the indicator inside a sticky parent. */
      isolation: isolate;
    }
  }
</style>

<script>
  function setupTocScrollspy(): void {
    const tocs = document.querySelectorAll<HTMLElement>('.toc');
    if (!tocs.length) return;

    const headings = document.querySelectorAll<HTMLElement>('.prose h2[id], .prose h3[id]');
    if (!headings.length) return;

    // Build a map once per setup so the inline summary text update doesn't
    // walk the heading list on every scroll-driven setActive.
    const headingMap = new Map<string, HTMLElement>();
    headings.forEach((h) => headingMap.set(h.id, h));

    tocs.forEach((toc) => {
      const indicator = toc.querySelector<HTMLElement>('.toc-indicator');
      const cur = toc.querySelector<HTMLElement>('.toc-current');
      if (!indicator) return;

      const linksByHref = new Map<string, HTMLElement>();
      toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
        const href = a.getAttribute('href');
        if (href) linksByHref.set(href, a);
      });

      const baseHeight = indicator.offsetHeight || 24;
      let activeId: string | null = null;
      // Debounce timer for aria-current updates. The visual indicator moves
      // immediately (no layout reflow impact), but we delay the aria-current
      // setAttribute by 150ms so AT doesn't fire a burst of announcements
      // during fast continuous scrolls. (P12 — Phase 1 audit finding.)
      let ariaCurrentTimer: number | undefined;

      function setActive(id: string): void {
        if (id === activeId) return;
        activeId = id;
        const link = linksByHref.get(`#${id}`);
        if (!link || !indicator) return;
        const ratio = link.offsetHeight / baseHeight;
        // Move the indicator bar immediately — compositor-only, no AT signal.
        indicator.style.transform = `translateY(${link.offsetTop}px) scaleY(${ratio})`;
        // Inline variant: surface the current heading in the collapsed summary.
        if (cur) {
          const heading = headingMap.get(id);
          if (heading) cur.textContent = heading.textContent ?? '';
        }
        // Debounce the aria-current update to avoid chatty AT announcements
        // while the user is actively scrolling through sections quickly.
        if (ariaCurrentTimer !== undefined) clearTimeout(ariaCurrentTimer);
        ariaCurrentTimer = window.setTimeout(() => {
          toc.querySelectorAll('a[aria-current]').forEach((a) => a.removeAttribute('aria-current'));
          link.setAttribute('aria-current', 'location');
          ariaCurrentTimer = undefined;
        }, 150);
      }

      function reposition(): void {
        if (activeId) {
          const id = activeId;
          activeId = null; // force re-apply
          setActive(id);
        }
      }

      const obs = new IntersectionObserver(
        (entries) => {
          if (document.visibilityState !== 'visible') return;
          for (const entry of entries) {
            if (entry.isIntersecting) setActive(entry.target.id);
          }
        },
        { rootMargin: '0px 0px -70% 0px' },
      );
      headings.forEach((h) => obs.observe(h));

      // Snap initial position (no animation), enable transitions next frame.
      const firstId = headings[0]?.id;
      if (firstId) {
        const prevTransition = indicator.style.transition;
        indicator.style.transition = 'none';
        setActive(firstId);
        requestAnimationFrame(() => {
          indicator.style.transition = prevTransition;
        });
      }

      // Re-position on resize / late font load — defensive against late
      // layout shifts that would leave the indicator stranded. Also fires
      // when the inline <details> opens (changes the bar's offsetParent).
      const ro = new ResizeObserver(reposition);
      ro.observe(toc);
      document.fonts?.ready.then(reposition).catch(() => {});

      // Cleanup on swap.
      document.addEventListener(
        'astro:before-swap',
        () => {
          obs.disconnect();
          ro.disconnect();
          if (ariaCurrentTimer !== undefined) clearTimeout(ariaCurrentTimer);
        },
        { once: true },
      );
    });
  }

  setupTocScrollspy();
  document.addEventListener('astro:page-load', setupTocScrollspy);
</script>
