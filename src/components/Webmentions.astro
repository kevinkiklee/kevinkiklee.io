---
import { fetchWebmentions } from '~/lib/webmentions';
import SectionTitle from './SectionTitle.astro';

interface Props {
  url: string;
}
const { url } = Astro.props;
const mentions = await fetchWebmentions(url);
const replies = mentions.filter((m) => m.type === 'reply');
const likes = mentions.filter((m) => m.type === 'like');
const reposts = mentions.filter((m) => m.type === 'repost');

// Empty-state branch: render nothing if no mentions. The previous version
// hid only the wrapper when total mentions were 0, but with replies + a
// non-zero like/repost count the section showed a header with no content.
const hasContent = replies.length > 0 || likes.length + reposts.length > 0;
---
{hasContent && (
  <section class="webmentions" aria-labelledby="wm-h">
    <SectionTitle id="wm-h" name="replies" level="h3" />
    {(likes.length + reposts.length) > 0 && (
      <p class="reactions">
        {/* aria-label replaces the Unicode symbol name AT would otherwise read
            (e.g. "BLACK HEART SUIT" / "ANTICLOCKWISE OPEN CIRCLE ARROW").
            P13 — Phase 1 audit finding. */}
        <span aria-label={`${likes.length} liked`}>{likes.length} ♥</span>
        {' · '}
        <span aria-label={`${reposts.length} shared`}>{reposts.length} ↻</span>
      </p>
    )}
    {replies.length > 0 && (
      <ul role="list">
        {replies.map((m) => (
          <li>
            <article class="h-entry" itemscope itemtype="https://schema.org/Comment">
              <div class="head">
                {m.author.photo && (
                  /* referrerpolicy=no-referrer blocks Gravatar/GitHub from
                     learning which post fetched the avatar. We intentionally
                     do NOT set crossorigin="anonymous" — browsers already
                     drop cookies on cross-origin image requests under the
                     SameSite=Lax default, and turning on CORS would make
                     the avatar fail-closed on any host that doesn't
                     advertise Access-Control-Allow-Origin. */
                  <img
                    class="avatar"
                    src={m.author.photo}
                    alt=""
                    width="32"
                    height="32"
                    loading="lazy"
                    decoding="async"
                    referrerpolicy="no-referrer"
                    itemprop="image"
                  />
                )}
                <div class="who">
                  {m.author.url ? (
                    <a href={m.author.url} class="p-author h-card" itemprop="author">
                      <strong class="p-name">{m.author.name}</strong>
                    </a>
                  ) : (
                    /* webmention.io occasionally returns a name with no
                       safe profile URL (anonymous reply, dropped by the
                       http(s) filter in webmentions.ts). Render the name
                       as plain text so we don't ship an empty-href <a>
                       that fails link-name + link-purpose checks. */
                    <span class="p-author h-card" itemprop="author">
                      <strong class="p-name">{m.author.name}</strong>
                    </span>
                  )}
                  {m.url ? (
                    <a href={m.url} itemprop="url" class="when">
                      {/* datetime carries the machine-readable ISO value;
                          visible text is the human-friendly YYYY-MM-DD slice.
                          `m.published` is already normalised to a valid ISO
                          string by webmentions.ts (malformed values are
                          dropped at fetch time). */}
                      <time class="dt-published" datetime={m.published}>
                        {m.published.slice(0, 10)}
                      </time>
                    </a>
                  ) : (
                    /* webmention.io occasionally returns a mention with no
                       safe source URL (anonymous, or dropped by the http(s)
                       filter in webmentions.ts). Render the time as plain
                       text rather than `<a href="">`, which would navigate
                       to the current page and fail link-purpose checks. */
                    <span class="when">
                      <time class="dt-published" datetime={m.published}>
                        {m.published.slice(0, 10)}
                      </time>
                    </span>
                  )}
                </div>
              </div>
              <p class="p-content e-content" itemprop="text">{m.content.text}</p>
            </article>
          </li>
        ))}
      </ul>
    )}
  </section>
)}

<style>
  .webmentions {
    margin-top: var(--space-7);
  }
  .reactions {
    color: var(--fg-muted);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    padding: var(--space-3) 0;
    border-top: 1px solid var(--rule-soft);
  }
  .head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .avatar {
    border-radius: 0;        /* brutalist — no rounding */
    flex: 0 0 auto;
  }
  .who {
    display: flex;
    flex-direction: column;
    /* Tap-target floor lives on each <a> below, not the column —
       stacked links each need their own 44px hit per WCAG 2.5.5. */
  }
  .who a {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: var(--fg);
  }
  /* `.who .when` may be rendered as <a> (tappable, 44px min) or as <span>
     (no safe URL upstream). Apply the visual treatment to both so the
     timestamp row reads identically either way. */
  .who .when {
    display: flex;
    align-items: center;
    color: var(--fg-muted);
    font-size: var(--text-xs);
  }
  li p {
    margin-top: var(--space-2);
    color: var(--fg-muted);
  }
</style>
