---
import Wren from '~/components/garden/Wren.astro';
import ThemeToggle from './ThemeToggle.astro';
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/posts', label: 'Writing' },
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About' },
];
function isCurrent(href: string) {
  if (href === '/') return path === '/';
  // Highlight on exact match OR on a true child route (`/posts/foo`),
  // but not on a sibling that happens to share a prefix
  // (e.g. `/projects` should not light up when on `/projects-archive`).
  return path === href || path.startsWith(`${href}/`);
}
---
<header class="site-header">
  <div class="row">
    <a href="/" class="brand" aria-label="Kevin Lee, home" style="view-transition-name: site-brand; view-transition-class: persistent;">
      Kevin Lee
    </a>
    <small class="role">chrome devrel · nyc</small>
    <nav id="site-nav" class="site-nav" aria-label="Primary" style="view-transition-name: site-nav; view-transition-class: persistent;">
      <ul role="list">
        {links.map((l) => (
          <li><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
        <li>
          <a
            href="/search"
            id="search-trigger"
            aria-keyshortcuts="Slash Meta+K Control+K"
            aria-expanded="false"
            aria-current={isCurrent('/search') ? 'page' : undefined}
          ><span class="slash" aria-hidden="true">/</span> search</a>
        </li>
      </ul>
    </nav>
    <span style="view-transition-name: theme-toggle-host; view-transition-class: persistent;">
      <ThemeToggle />
    </span>
  </div>
  <Wren />
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule-soft);
    padding: var(--space-4) var(--space-5);
    position: sticky;
    top: 0;
    background: var(--bg);
    z-index: 10;
    contain: layout;
    /* Persist the header element across ClientRouter swaps so the banner
       doesn't re-mount + reflow on every nav. */
    view-transition-name: site-header;
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    max-width: 1100px;
    margin: 0 auto;
    flex-wrap: wrap;
    /* Reserve enough vertical room for the role strip whether it's visible
       or hidden, so toggling the breakpoint never produces CLS. */
    min-height: 56px;
  }
  /* Sentence-case sans-serif wordmark — no terminal-prompt affectation. */
  .brand {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-sans);
    font-weight: 650;
    font-size: var(--text-sm);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  /* Wren perches on the header's bottom rule. `.site-header` is already a
     positioned element (`position: sticky`), so it's the containing block —
     no extra position context needed. `contain: layout` above does NOT clip
     visual overflow (that requires `overflow`/`contain: paint`), so the bird
     hanging past the rule at `bottom: -2px` stays visible. */
  :global(.garden-wren) {
    position: absolute;
    right: 64px;
    bottom: -2px;
  }
  @media (max-width: 640px) {
    :global(.garden-wren) { display: none; }
  }

  .role {
    font-size: var(--text-xs);
    color: var(--fg-muted);
    letter-spacing: 0.02em;
    white-space: nowrap;
    flex: 0 1 auto;
  }
  /* Drop the role strip on phones below 380px so the banner doesn't wrap
     past two lines on small devices. The same identity also lives in
     JSON-LD Person + the About page, so nothing is lost. */
  @media (max-width: 379px) {
    .role { display: none; }
  }

  .site-nav ul {
    display: flex;
    gap: var(--space-5);
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
  }
  /*
   * Tap targets: WCAG 2.5.5 / 2.5.8 wants ≥24px; Apple HIG wants ≥44px.
   * inline-flex + min-height gives us a consistent 44px regardless of
   * the rendered text height.
   */
  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-2) var(--space-1);
    color: var(--fg-muted);
    transition: color 180ms var(--ease);
  }
  .site-nav a:hover,
  .site-nav a:focus-visible { color: var(--fg); }
  .site-nav a[aria-current='page'] {
    color: var(--fg);
    font-weight: 600;
    /* Border + weight (not colour alone) signals current state — preserved
       for forced-colors and colour-blind users. */
    border-bottom: 2px solid var(--accent);
  }
  .site-nav .slash {
    color: var(--accent);
    font-weight: 700;
    margin-right: 0.15em;
  }

  @media (max-width: 640px) {
    .site-header { padding: var(--space-3) var(--space-5); }
    .row { gap: var(--space-3); justify-content: flex-start; }
    .site-nav {
      order: 4;
      width: 100%;
      overflow-x: auto;
      /* iOS momentum scroll for the horizontal nav strip. */
      -webkit-overflow-scrolling: touch;
      /* Right-edge fade telegraphs "more nav off-screen". Nav has no
         absolutely-positioned children, so the mask doesn't clip
         anything visible. Always-on (last 24px) so it reads as
         intentional even when fully scrolled. */
      mask-image: linear-gradient(to right, black calc(100% - 24px), transparent);
      -webkit-mask-image: linear-gradient(to right, black calc(100% - 24px), transparent);
    }
    .site-nav ul {
      gap: var(--space-4);
      /* Snap to the start of each nav item so users land on whole labels
         when fling-scrolling, not mid-word. */
      scroll-snap-type: x proximity;
    }
    .site-nav li { scroll-snap-align: start; }
  }

  @media (forced-colors: active) {
    .site-nav { mask: none; -webkit-mask: none; }
  }
</style>

<script>
  // Desktop: hijack the search nav link to open the global Cmd-K palette.
  // Mobile (coarse pointer): fall through to /search route, since the palette
  // is a poor fit for touch + on-screen keyboard.
  // If JS is disabled entirely, the link still navigates to /search.
  //
  // NOTE: ClientRouter replaces the header element on each navigation, so a
  // single addEventListener at script-load time only covers the first page.
  // We use document-level event delegation so the click handler survives
  // every swap without re-binding.
  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    const trigger = target?.closest('#search-trigger');
    if (!trigger) return;
    if (window.matchMedia?.('(pointer: coarse)').matches) return;
    e.preventDefault();
    document.dispatchEvent(new KeyboardEvent('keydown', { key: '/' }));
  });

  // Sync aria-expanded on the trigger to the dialog's open state, so
  // screen readers know whether the palette is open. Re-binds the
  // dialog event listeners after every swap because the <Header> is
  // re-rendered (the listener attached on first load is lost when the
  // <dialog> element gets recreated).
  function syncSearchTriggerExpanded() {
    const trigger = document.getElementById('search-trigger');
    const palette = document.getElementById('search-palette');
    if (!trigger || !palette) return;
    trigger.setAttribute('aria-expanded', String(palette.hasAttribute('open')));
  }
  function bindPaletteSync() {
    const palette = document.getElementById('search-palette');
    if (!palette || (palette as HTMLElement).dataset.expandedSyncBound === '1') return;
    (palette as HTMLElement).dataset.expandedSyncBound = '1';
    palette.addEventListener('toggle', syncSearchTriggerExpanded);
    palette.addEventListener('close', syncSearchTriggerExpanded);
  }
  syncSearchTriggerExpanded();
  bindPaletteSync();
  document.addEventListener('astro:page-load', () => {
    syncSearchTriggerExpanded();
    bindPaletteSync();
  });
</script>
