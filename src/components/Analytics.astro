---
import { GA_MEASUREMENT_ID } from 'astro:env/client';
const ga = GA_MEASUREMENT_ID;
---
<script>
  import { whenActivated } from '~/lib/prerender-analytics';

  /**
   * Respect the user's tracking-opt-out signals before injecting any
   * analytics. Vercel Web Analytics is cookieless / aggregated, but the
   * privacy-conscious thing is still to honour an explicit opt-out:
   *   - Sec-GPC (Global Privacy Control) — the standardised successor to DNT
   *   - navigator.doNotTrack — legacy DNT signal
   * Either signal short-circuits the analytics load entirely.
   */
  function userOptedOut(): boolean {
    type Nav = Navigator & {
      globalPrivacyControl?: boolean;
      doNotTrack?: string | null;
      msDoNotTrack?: string | null;
    };
    const nav = navigator as Nav;
    if (nav.globalPrivacyControl === true) return true;
    const dnt = nav.doNotTrack ?? nav.msDoNotTrack ?? null;
    return dnt === '1' || dnt === 'yes';
  }

  async function load() {
    if (userOptedOut()) return;
    // Two separate `import()` calls (rather than one Promise.all-with-array
    // destructure) so Vite emits two distinct chunks for @vercel/analytics
    // and @vercel/speed-insights. They share no code, and a single tuple
    // import made Rollup occasionally collapse them into one fat chunk.
    //
    // allSettled (not all): a transient 404 on one provider's chunk shouldn't
    // suppress the other. Each module is independent — degrading gracefully
    // when one is unavailable is strictly better than dropping both.
    const analyticsP = import('@vercel/analytics').then((m) => m.inject());
    const speedP = import('@vercel/speed-insights').then((m) => m.injectSpeedInsights());
    const results = await Promise.allSettled([analyticsP, speedP]);
    // Surface failures in dev/preview; production users won't see these,
    // but they make debugging a missing provider in CI trivial.
    for (const r of results) {
      if (r.status === 'rejected') console.warn('[analytics] provider failed:', r.reason);
    }
  }

  whenActivated(() => {
    if ('requestIdleCallback' in window) {
      (window as Window).requestIdleCallback(load, { timeout: 1500 });
    } else {
      setTimeout(load, 800);
    }
  });
</script>

{ga && (
  <script is:inline define:vars={{ ga }}>
    {`
      // Same DNT/Sec-GPC opt-out applied to GA: privacy-conscious users
      // should never trigger the GTM/GA bundle download, not just have
      // its beacons silenced after the fact.
      (function () {
        var nav = navigator;
        var dnt = nav.doNotTrack || nav.msDoNotTrack || null;
        if (nav.globalPrivacyControl === true || dnt === '1' || dnt === 'yes') return;
        window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', ga, { allow_google_signals: false });
        var s = document.createElement('script');
        s.type = 'text/partytown';
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(ga);
        document.head.appendChild(s);
      })();
    `}
  </script>
)}
