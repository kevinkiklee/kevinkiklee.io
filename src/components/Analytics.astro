---
import { GA_MEASUREMENT_ID } from 'astro:env/client';
const ga = GA_MEASUREMENT_ID;
---
<script>
  import { whenActivated } from '~/lib/prerender-analytics';

  async function load() {
    // Two separate `import()` calls (rather than one Promise.all-with-array
    // destructure) so Vite emits two distinct chunks for @vercel/analytics
    // and @vercel/speed-insights. They share no code, and a single tuple
    // import made Rollup occasionally collapse them into one fat chunk.
    const analyticsP = import('@vercel/analytics').then((m) => m.inject());
    const speedP = import('@vercel/speed-insights').then((m) => m.injectSpeedInsights());
    await Promise.all([analyticsP, speedP]);
  }

  whenActivated(() => {
    if ('requestIdleCallback' in window) {
      (window as Window).requestIdleCallback(load, { timeout: 1500 });
    } else {
      setTimeout(load, 800);
    }
  });
</script>

{ga && (
  <>
    <script is:inline type="text/partytown" src={`https://www.googletagmanager.com/gtag/js?id=${ga}`} async></script>
    <script is:inline type="text/partytown" set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${ga}',{anonymize_ip:true,allow_google_signals:false});`}></script>
  </>
)}
