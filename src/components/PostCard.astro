---
import type { CollectionEntry } from 'astro:content';
import PostMeta from './PostMeta.astro';

interface Props {
  post: CollectionEntry<'posts'>;
  index?: number | undefined;
}
const { post, index = 0 } = Astro.props;
const { title, description, pubDate, tags } = post.data;
---
<article class="post-card reveal" style={`--i:${index}`}>
  {/* Only the title is a real <a> — its ::after stretches the hit area to
      the whole card (see .post-card h3 a::after below). The title text is
      already the link's accessible name. Nesting an <a> around the meta
      row would put TagPill's own <a> INSIDE this one; nested <a> is invalid
      HTML, and browsers silently split the outer anchor into multiple
      fragments (one per run of text around the nested link), each far
      short of a usable — or WCAG 2.5.8-sized — tap target. */}
  <h3 data-slug={post.id}>
    <a href={`/posts/${post.id}`}><span class="title">{title}</span></a>
  </h3>
  <PostMeta pubDate={pubDate} tags={tags} />
  <p>{description}</p>
  <span class="cta">→ read post</span>
</article>

<script>
  // Only the topmost in-viewport post-card carries view-transition-name.
  // Idempotent: PostCard may render many times per page, but the script is
  // hoisted once globally by Astro. Guard prevents re-init on re-runs.
  // `__postCardVTInit` is declared on `Window` in `src/env.d.ts`.
  if (!window.__postCardVTInit) {
    window.__postCardVTInit = true;

    const setup = () => {
      const cards = Array.from(document.querySelectorAll<HTMLElement>('.post-card h3[data-slug]'));
      if (cards.length === 0) return;
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const el = entry.target as HTMLElement;
            const slug = el.dataset.slug;
            if (!slug) continue;
            el.style.viewTransitionName = entry.isIntersecting ? `post-title-${slug}` : '';
          }
        },
        { threshold: 0.5 },
      );
      for (const c of cards) io.observe(c);
    };

    setup();
    // Re-run after view-transition swaps so newly mounted cards get observed.
    document.addEventListener('astro:after-swap', setup);
  }

  // Race-free post-title morph: set view-transition-name synchronously
  // on pointerdown, BEFORE the click→navigation pipeline. The IO setter
  // (above) handles the "scroll-to-card" path; this handler covers the
  // "click a card you can see right now" path.
  function setVTNameOnPointerDown() {
    document.querySelectorAll<HTMLElement>('.post-card h3[data-slug]').forEach((h) => {
      if (h.dataset.vtBound === '1') return;
      h.dataset.vtBound = '1';
      const card = h.closest('.post-card');
      card?.addEventListener('pointerdown', () => {
        const slug = h.dataset.slug;
        if (slug) h.style.viewTransitionName = `post-title-${slug}`;
      });
    });
  }
  setVTNameOnPointerDown();
  document.addEventListener('astro:page-load', setVTNameOnPointerDown);
</script>

<style>
  .post-card {
    position: relative;
    border-top: 1px solid var(--rule-soft);
    padding: var(--space-4) 0;
    container-type: inline-size;
    content-visibility: auto;
    contain-intrinsic-size: 1px 200px;
    contain: layout paint;
  }
  /* Stretched-link pattern: the title <a> is the only real link, but its
     ::after covers the whole card (absolute + inset:0 resolve against the
     nearest positioned ancestor, .post-card, not the <a>'s own small box).
     TagPill's own z-index keeps the tag links clickable above this layer. */
  .post-card h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .post-card h3 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-lg);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-2);
  }
  .post-card p {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--fg-muted);
    margin-top: var(--space-3);
    max-width: var(--measure);
  }
  .post-card .cta {
    font-family: var(--font-sans);
    color: var(--accent);
    display: inline-block;
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    transition:
      transform 180ms var(--ease),
      color 180ms var(--ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .post-card:hover { border-top-color: var(--rule); }
    .post-card:hover .cta { transform: translateX(4px); }
  }
  /* Keyboard parity: tab-focusing the card link should darken the top rule
     the same way hovering does, so the active row is visually anchored. */
  .post-card:focus-within { border-top-color: var(--rule); }
  .post-card:focus-within .cta { transform: translateX(4px); }
  @media (max-width: 640px) {
    .post-card p {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }
</style>
