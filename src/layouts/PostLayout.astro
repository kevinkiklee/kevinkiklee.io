---
import { Picture, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import DiscussFooter from '~/components/DiscussFooter.astro';
import JsonLd from '~/components/JsonLd.astro';
import PostMeta from '~/components/PostMeta.astro';
import PostNav from '~/components/PostNav.astro';
import RelatedPosts from '~/components/RelatedPosts.astro';
import TableOfContents from '~/components/TableOfContents.astro';
import { crumbsFor } from '~/lib/crumbs';
import { getPublishedPosts, prevNextFor, sortByDateDesc } from '~/lib/posts';
import {
  ENTITY_IDS,
  buildBlog,
  buildBlogPosting,
  buildBreadcrumbs,
  buildPageGraph,
  buildWebSite,
} from '~/lib/schema';
import { SITE } from '~/lib/site-config';
import BaseLayout from './BaseLayout.astro';

interface Props {
  post: CollectionEntry<'posts'>;
  minutesRead?: number | undefined;
  wordCount?: number | undefined;
  headings?: MarkdownHeading[] | undefined;
}
const { post, minutesRead, wordCount, headings = [] } = Astro.props;
const { title, description, pubDate, updatedDate, tags, cover, series } = post.data;

const allPosts = sortByDateDesc(await getPublishedPosts());
const { prev, next } = prevNextFor(post, allPosts);
const crumbs = crumbsFor(Astro.url.pathname, { title: post.data.title });
const faq = post.data.faq ?? [];

const postUrl = new URL(`/posts/${post.id}`, Astro.site).toString();
const ogImageUrl = new URL(`/api/og?slug=${post.id}`, Astro.site).toString();
const authorUrl = new URL('/about', Astro.site).toString();

// If the post has a cover image, preload the responsive srcset so the LCP
// element loads in parallel with the HTML parse. We emit BOTH an AVIF and a
// WebP preload — the browser uses `image/avif` `type` to pick the AVIF
// variant where supported and falls back to WebP otherwise. AVIF is the
// LCP candidate on modern Chrome/Safari, so it gets `fetchpriority="high"`.
let lcpImage: { sizes: string; avifSrcset?: string; webpSrcset?: string } | undefined;
if (cover) {
  const sizes = '(min-width: 768px) 720px, 100vw';
  const widths = [480, 768, 1024, 1536];
  const [avif, webp] = await Promise.all([
    getImage({ src: cover.src, widths, sizes, format: 'avif' }),
    getImage({ src: cover.src, widths, sizes, format: 'webp' }),
  ]);
  lcpImage = {
    sizes,
    avifSrcset: avif.srcSet?.attribute,
    webpSrcset: webp.srcSet?.attribute,
  };
}

const origin = new URL('/', Astro.site).toString().slice(0, -1);

const blogPostingArgs: Parameters<typeof buildBlogPosting>[0] = {
  url: postUrl,
  title,
  description,
  pubDate,
  tags,
  imageUrl: ogImageUrl,
  authorUrl,
};
if (updatedDate) blogPostingArgs.updatedDate = updatedDate;
if (typeof wordCount === 'number') blogPostingArgs.wordCount = wordCount;
if (typeof minutesRead === 'number') blogPostingArgs.minutesRead = minutesRead;
if (post.data.faq) blogPostingArgs.faq = post.data.faq;
if (SITE.license) blogPostingArgs.license = SITE.license;

const graph = buildPageGraph([
  buildBlogPosting(blogPostingArgs),
  buildBlog(),
  buildBreadcrumbs(
    [
      { name: '~', url: '/' },
      { name: 'posts', url: '/posts' },
      { name: title, url: `/posts/${post.id}` },
    ],
    origin,
  ),
  buildWebSite(),
  { '@id': ENTITY_IDS.person },
]);
---
<BaseLayout
  title={`${title} · kevinkiklee.io`}
  description={description}
  ogType="article"
  ogImageUrl={ogImageUrl}
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  {tags}
  {lcpImage}
  canonical={postUrl}
  markdownAlternateUrl={`${SITE.url}/posts/${post.id}.md`}
  prevUrl={prev ? `${SITE.url}/posts/${prev.id}` : undefined}
  nextUrl={next ? `${SITE.url}/posts/${next.id}` : undefined}
>
  <JsonLd slot="head" data={graph} />
  <Breadcrumbs items={crumbs} />
  <article class="post">
    <p class="eyebrow" aria-hidden="true">
      <span class="dol">$</span> cat {post.id}.md
    </p>
    <header>
      <h1 data-no-anim style={`view-transition-name: post-title-${post.id};`}>{title}</h1>
      <PostMeta variant="rail" {pubDate} {updatedDate} {tags} {minutesRead} {wordCount} />
    </header>
    {cover && (
      <figure class="post-hero">
        <Picture
          src={cover.src}
          alt={cover.alt}
          widths={[800, 1200, 2400]}
          sizes="(min-width: 1100px) 1100px, 100vw"
          formats={['avif', 'webp']}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    )}
    {series && (
      <aside class="series-banner" aria-label="Series">
        <span>Series · {series.name} · part {series.order}</span>
      </aside>
    )}
    <div class="post-body">
      {headings.length > 0 && (
        <div class="toc-inline">
          <TableOfContents {headings} variant="inline" />
        </div>
      )}
      <div class="prose">
        <slot />
      </div>
      {headings.length > 0 && (
        <div class="toc-aside">
          <TableOfContents {headings} variant="aside" />
        </div>
      )}
    </div>
    <RelatedPosts post={post} />
    {faq.length > 0 && (
      <section class="faq" aria-labelledby="faq-heading">
        <h2 id="faq-heading">FAQ</h2>
        <dl>
          {faq.map((qa) => (
            <>
              <dt>{qa.q}</dt>
              <dd>{qa.a}</dd>
            </>
          ))}
        </dl>
      </section>
    )}
    <PostNav prev={prev} next={next} />
    <DiscussFooter
      postUrl={postUrl}
      postTitle={title}
      mastodonUrl={post.data.mastodonUrl}
    />
  </article>
</BaseLayout>

<style>
  .eyebrow {
    font-size: var(--text-xs);
    color: var(--fg-muted);
    margin-bottom: var(--space-2);
    letter-spacing: 0.02em;
    font-family: var(--font-mono);
  }
  /* `.eyebrow .dol` color is `var(--accent)`; `tokens.css` already remaps
     that to `LinkText` under forced-colors. No per-component override needed. */
  .eyebrow .dol {
    color: var(--accent);
    margin-right: 0.35em;
    font-weight: 700;
  }
  .post header { margin-bottom: var(--space-6); }
  h1 {
    font-size: var(--text-2xl);
    letter-spacing: -0.01em;
    line-height: var(--leading-tight);
    margin-bottom: var(--space-3);
  }
  /* Cover hero: full-width within the post column, sharp brutalist border
     on the bottom edge, no border-radius. The img element fills the figure
     so the responsive srcset above does the heavy lifting. */
  .post-hero {
    margin: 0 0 var(--space-6);
    border-bottom: 2px solid var(--rule);
  }
  .post-hero :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
  /* Honour `prefers-reduced-data`: hero is decorative, so skip the hero
     fetch entirely on metered or data-saver connections. */
  @media (prefers-reduced-data: reduce) {
    .post-hero { display: none; }
  }
  .series-banner {
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    color: var(--fg-muted);
    border-left: 3px solid var(--accent);
    background: var(--code-bg);
    padding: var(--space-2) var(--space-3);
    margin-bottom: var(--space-6);
  }
  .prose { max-width: var(--measure); }
  .faq { margin-top: var(--space-6); }
  .faq h2 { font-size: var(--text-lg); margin-bottom: var(--space-3); }
  .faq dt { font-weight: 600; margin-top: var(--space-3); }
  .faq dd { margin: 0 0 var(--space-2) 0; }
  /* Default: stack the inline TOC at the top, hide the sticky aside. */
  .toc-inline { margin-bottom: var(--space-6); }
  .toc-aside { display: none; }

  /* On wide viewports, show the sticky aside next to the prose and hide
     the inline TOC. The grid keeps the prose at its measure and parks the
     TOC in a 220px column on the right. */
  @media (min-width: 1024px) {
    .post-body {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 220px;
      gap: var(--space-6);
      align-items: start;
    }
    .toc-inline { display: none; }
    .toc-aside { display: block; }
  }

  /* Below-the-fold rhythm: gap between major post-tail sections.
     :global() because .related and .discuss are rendered by child
     components and carry their own scoped cid attribute. */
  .post > :global(.related),
  .post > :global(.discuss) {
    margin-top: var(--space-7);
  }
  @media (min-width: 1024px) {
    .post > :global(.related),
    .post > :global(.discuss) {
      margin-top: var(--space-8);
    }
  }
</style>

<script>
  // Set / clear data-progress on body around post navigations.
  function setProgress() { document.body.setAttribute('data-progress', ''); }
  function clearProgress() { document.body.removeAttribute('data-progress'); }

  // Fired on initial load and after each ClientRouter navigation.
  document.addEventListener('astro:page-load', () => {
    if (document.querySelector('.post')) setProgress();
    else clearProgress();
  });
  // Cleared before navigating away.
  document.addEventListener('astro:before-swap', clearProgress);

  // Fallback for browsers without CSS scroll-driven animations.
  if (!CSS.supports('animation-timeline', '--x')) {
    import('~/lib/reading-progress-fallback').then(({ attach }) => attach());
  }
</script>

<script>
  // P4: Conditional code-block keyboard scroll region.
  // Only adds tabindex / role / aria-label when the block actually overflows.
  function applyCodeBlockA11y() {
    document.querySelectorAll('main pre').forEach((pre) => {
      const el = pre as HTMLElement;
      if (el.scrollWidth > el.clientWidth) {
        el.tabIndex = 0;
        el.setAttribute('role', 'region');
        const codeEl = el.querySelector('code');
        const langClass =
          Array.from(el.classList).find((c) => c.startsWith('language-')) ??
          Array.from(codeEl?.classList ?? []).find((c) => c.startsWith('language-'));
        const lang = langClass?.replace('language-', '');
        el.setAttribute(
          'aria-label',
          lang && lang !== 'plaintext' && lang !== 'text' ? `Code, ${lang}` : 'Code',
        );
      }
    });
  }

  // P5: Conditional table scroll region.
  // Wraps overflowing tables in a role=region div; idempotent on re-runs.
  function applyTableA11y() {
    document.querySelectorAll('main table').forEach((table) => {
      const t = table as HTMLElement;
      // Skip if already wrapped (e.g., on view transition re-run).
      if (t.parentElement?.getAttribute('role') === 'region') return;
      requestAnimationFrame(() => {
        if (t.scrollWidth <= t.clientWidth) return;
        const wrap = document.createElement('div');
        wrap.setAttribute('role', 'region');
        wrap.setAttribute('aria-label', 'Table');
        wrap.tabIndex = 0;
        wrap.style.overflowX = 'auto';
        t.parentNode?.insertBefore(wrap, t);
        wrap.appendChild(t);
      });
    });
  }

  applyCodeBlockA11y();
  applyTableA11y();
  document.addEventListener('astro:page-load', () => {
    applyCodeBlockA11y();
    applyTableA11y();
  });
</script>
