---
import { Picture, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import DiscussFooter from '~/components/DiscussFooter.astro';
import JsonLd from '~/components/JsonLd.astro';
import PostMeta from '~/components/PostMeta.astro';
import RelatedPosts from '~/components/RelatedPosts.astro';
import TableOfContents from '~/components/TableOfContents.astro';
import { buildBlogPosting, buildBreadcrumbs } from '~/lib/schema';
import BaseLayout from './BaseLayout.astro';

interface Props {
  post: CollectionEntry<'posts'>;
  minutesRead?: number | undefined;
  wordCount?: number | undefined;
  headings?: MarkdownHeading[] | undefined;
}
const { post, minutesRead, wordCount, headings = [] } = Astro.props;
const { title, description, pubDate, updatedDate, tags, cover, series } = post.data;

const postUrl = new URL(`/posts/${post.id}`, Astro.site).toString();
const ogImageUrl = new URL(`/api/og?slug=${post.id}`, Astro.site).toString();
const authorUrl = new URL('/about', Astro.site).toString();

// If the post has a cover image, preload the responsive srcset so the LCP
// element loads in parallel with the HTML parse. We emit BOTH an AVIF and a
// WebP preload — the browser uses `image/avif` `type` to pick the AVIF
// variant where supported and falls back to WebP otherwise. AVIF is the
// LCP candidate on modern Chrome/Safari, so it gets `fetchpriority="high"`.
let lcpImage: { sizes: string; avifSrcset?: string; webpSrcset?: string } | undefined;
if (cover) {
  const sizes = '(min-width: 768px) 720px, 100vw';
  const widths = [480, 768, 1024, 1536];
  const [avif, webp] = await Promise.all([
    getImage({ src: cover.src, widths, sizes, format: 'avif' }),
    getImage({ src: cover.src, widths, sizes, format: 'webp' }),
  ]);
  lcpImage = {
    sizes,
    avifSrcset: avif.srcSet?.attribute,
    webpSrcset: webp.srcSet?.attribute,
  };
}

const origin = new URL('/', Astro.site).toString().slice(0, -1);

const jsonLd = [
  buildBlogPosting({
    url: postUrl,
    title,
    description,
    pubDate,
    updatedDate,
    tags,
    imageUrl: ogImageUrl,
    wordCount,
    minutesRead,
    authorUrl,
  }),
  buildBreadcrumbs(
    [
      { name: '~', url: '/' },
      { name: 'posts', url: '/posts' },
      { name: title, url: `/posts/${post.id}` },
    ],
    origin,
  ),
];
---
<BaseLayout
  title={`${title} · kevinkiklee.io`}
  description={description}
  ogType="article"
  ogImageUrl={ogImageUrl}
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  {tags}
  {lcpImage}
>
  <JsonLd slot="head" data={jsonLd} />
  <article class="post">
    <p class="url-prompt"><span aria-hidden="true">$</span> posts/{post.id}</p>
    <header>
      <h1 data-no-anim style={`view-transition-name: post-title-${post.id};`}>{title}</h1>
      <PostMeta {pubDate} {updatedDate} {tags} {minutesRead} />
    </header>
    {cover && (
      <figure class="post-hero">
        <Picture
          src={cover.src}
          alt={cover.alt}
          widths={[800, 1200, 2400]}
          sizes="(min-width: 1100px) 1100px, 100vw"
          formats={['avif', 'webp']}
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    )}
    {series && (
      <nav class="series-banner" aria-label="Series navigation">
        <span>Series · {series.name} · part {series.order}</span>
      </nav>
    )}
    <div class="post-body">
      {headings.length > 0 && (
        <div class="toc-inline">
          <TableOfContents headings={headings} />
        </div>
      )}
      <div class="prose">
        <slot />
      </div>
      {headings.length > 0 && (
        <div class="toc-aside">
          <TableOfContents headings={headings} />
        </div>
      )}
    </div>
    <RelatedPosts post={post} />
    <DiscussFooter
      postUrl={postUrl}
      postTitle={title}
      mastodonUrl={post.data.mastodonUrl}
    />
  </article>
</BaseLayout>

<style>
  .url-prompt {
    font-size: var(--text-xs);
    color: var(--fg-muted);
    margin-bottom: var(--space-2);
    letter-spacing: 0.04em;
  }
  .url-prompt span {
    margin-right: 0.4em;
    color: var(--fg-subtle);
  }
  .post header { margin-bottom: var(--space-6); }
  h1 {
    font-size: var(--text-2xl);
    letter-spacing: -0.01em;
    line-height: var(--leading-tight);
    margin-bottom: var(--space-3);
  }
  /* Cover hero: full-width within the post column, sharp brutalist border
     on the bottom edge, no border-radius. The img element fills the figure
     so the responsive srcset above does the heavy lifting. */
  .post-hero {
    margin: 0 0 var(--space-6);
    border-bottom: 2px solid var(--rule);
  }
  .post-hero :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
  /* Honour `prefers-reduced-data`: hero is decorative, so skip the hero
     fetch entirely on metered or data-saver connections. */
  @media (prefers-reduced-data: reduce) {
    .post-hero { display: none; }
  }
  .series-banner {
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    color: var(--fg-muted);
    border-left: 3px solid var(--accent);
    background: var(--code-bg);
    padding: var(--space-2) var(--space-3);
    margin-bottom: var(--space-6);
  }
  .prose { max-width: var(--measure); }
  /* Default: stack the inline TOC at the top, hide the sticky aside. */
  .toc-inline { margin-bottom: var(--space-6); }
  .toc-aside { display: none; }

  /* On wide viewports, show the sticky aside next to the prose and hide
     the inline TOC. The grid keeps the prose at its measure and parks the
     TOC in a 220px column on the right. */
  @media (min-width: 1024px) {
    .post-body {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 220px;
      gap: var(--space-6);
      align-items: start;
    }
    .toc-inline { display: none; }
    .toc-aside { display: block; }
  }
</style>
