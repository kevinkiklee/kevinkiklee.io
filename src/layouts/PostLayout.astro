---
import type { MarkdownHeading } from 'astro';
import { getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import DiscussFooter from '~/components/DiscussFooter.astro';
import JsonLd from '~/components/JsonLd.astro';
import PostMeta from '~/components/PostMeta.astro';
import RelatedPosts from '~/components/RelatedPosts.astro';
import TableOfContents from '~/components/TableOfContents.astro';
import { buildBlogPosting, buildBreadcrumbs } from '~/lib/schema';
import BaseLayout from './BaseLayout.astro';

interface Props {
  post: CollectionEntry<'posts'>;
  minutesRead?: number | undefined;
  wordCount?: number | undefined;
  headings?: MarkdownHeading[] | undefined;
}
const { post, minutesRead, wordCount, headings = [] } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;

const postUrl = new URL(`/posts/${post.id}`, Astro.site).toString();
const ogImageUrl = new URL(`/api/og?slug=${post.id}`, Astro.site).toString();
const authorUrl = new URL('/about', Astro.site).toString();
const homeUrl = new URL('/', Astro.site).toString();
const postsUrl = new URL('/posts', Astro.site).toString();

// If the post has a cover image, preload the responsive srcset so the LCP
// element loads in parallel with the HTML parse. Falls back to undefined
// for posts without a cover (most of them, including hello-world).
let lcpImage: { srcset: string; sizes: string } | undefined;
if (post.data.cover) {
  const optimized = await getImage({
    src: post.data.cover.src,
    widths: [480, 768, 1024, 1536],
    sizes: '(min-width: 768px) 720px, 100vw',
    format: 'webp',
  });
  if (optimized.srcSet?.attribute) {
    lcpImage = {
      srcset: optimized.srcSet.attribute,
      sizes: '(min-width: 768px) 720px, 100vw',
    };
  }
}

const jsonLd = [
  buildBlogPosting({
    url: postUrl,
    title,
    description,
    pubDate,
    updatedDate,
    tags,
    imageUrl: ogImageUrl,
    wordCount,
    minutesRead,
    authorUrl,
  }),
  buildBreadcrumbs([
    { name: 'Home', url: homeUrl },
    { name: 'Posts', url: postsUrl },
    { name: title, url: postUrl },
  ]),
];
---
<BaseLayout
  title={`${title} · kevinkiklee.io`}
  description={description}
  ogType="article"
  ogImageUrl={ogImageUrl}
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  {tags}
  {lcpImage}
>
  <JsonLd slot="head" data={jsonLd} />
  <article class="post">
    <header>
      <h1 style={`view-transition-name: post-title-${post.id};`}>{title}</h1>
      <PostMeta {pubDate} {updatedDate} {tags} {minutesRead} />
    </header>
    <div class="post-body">
      {headings.length > 0 && (
        <div class="toc-inline">
          <TableOfContents headings={headings} />
        </div>
      )}
      <div class="prose">
        <slot />
      </div>
      {headings.length > 0 && (
        <div class="toc-aside">
          <TableOfContents headings={headings} />
        </div>
      )}
    </div>
    <RelatedPosts post={post} />
    <DiscussFooter
      postUrl={postUrl}
      postTitle={title}
      mastodonUrl={post.data.mastodonUrl}
    />
  </article>
</BaseLayout>

<style>
  .post header { margin-bottom: var(--space-6); }
  h1 {
    font-size: var(--text-2xl);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin-bottom: var(--space-3);
  }
  .prose { max-width: var(--measure); }
  /* Default: stack the inline TOC at the top, hide the sticky aside. */
  .toc-inline { margin-bottom: var(--space-6); }
  .toc-aside { display: none; }

  /* On wide viewports, show the sticky aside next to the prose and hide
     the inline TOC. The grid keeps the prose at its measure and parks the
     TOC in a 220px column on the right. */
  @media (min-width: 1024px) {
    .post-body {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 220px;
      gap: var(--space-6);
      align-items: start;
    }
    .toc-inline { display: none; }
    .toc-aside { display: block; }
  }
</style>
