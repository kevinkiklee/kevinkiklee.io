---
import '~/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Analytics from '~/components/Analytics.astro';
import BaseHead from '~/components/BaseHead.astro';
import CopyButton from '~/components/CopyButton.astro';
import Footer from '~/components/Footer.astro';
import Header from '~/components/Header.astro';
import KeyboardShortcuts from '~/components/KeyboardShortcuts.astro';
import PostBodyReveal from '~/components/PostBodyReveal.astro';
import PrerenderRules from '~/components/PrerenderRules.astro';
import SearchPalette from '~/components/SearchPalette.astro';
import ShortcutsOverlay from '~/components/ShortcutsOverlay.astro';

interface Props {
  title: string;
  description?: string | undefined;
  canonical?: string | undefined;
  ogType?: 'website' | 'article' | 'profile' | undefined;
  ogImageUrl?: string | undefined;
  publishedTime?: Date | undefined;
  modifiedTime?: Date | undefined;
  tags?: string[] | undefined;
  noindex?: boolean | undefined;
  prevUrl?: string | undefined;
  nextUrl?: string | undefined;
  markdownAlternateUrl?: string | undefined;
  profileFirstName?: string | undefined;
  profileLastName?: string | undefined;
  lcpImage?:
    | { sizes: string; avifSrcset?: string | undefined; webpSrcset?: string | undefined }
    | undefined;
}
const { title, description = '', ...rest } = Astro.props;
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <BaseHead title={title} description={description} {...rest} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#f5f4ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    {/* Unmediaed theme-color updated by ~/lib/theme on manual toggle so the
        mobile browser chrome tracks the user's choice (not the OS default). */}
    <meta name="theme-color" content="#f5f4ee" />
    <script is:inline>
      // First-paint marker: read + cleared by astro:after-swap to skip the
      // post-body reveal on initial load (LCP candidate paints immediately).
      document.documentElement.dataset.firstPaint = '1';
    </script>
    <script is:inline>
      (function () {
        function apply() {
          // localStorage access throws under sandboxed iframes and certain
          // private-mode contexts. Defensive try/catch avoids blocking the
          // first-paint theme application when storage is unavailable.
          var stored = null;
          try { stored = localStorage.getItem('theme'); } catch (e) {}
          var prefers = matchMedia('(prefers-color-scheme: dark)').matches;
          var t = stored === 'dark' || stored === 'light'
            ? stored
            : (prefers ? 'dark' : 'light');
          var bg = t === 'dark' ? '#0a0a0a' : '#f5f4ee';
          document.documentElement.dataset.theme = t;
          document.documentElement.style.background = bg;
          // Sync the JS-controlled theme-color meta so mobile browser chrome
          // tracks the user's manual override (the media-conditioned metas
          // alone follow OS preference only).
          var meta = document.querySelector('meta[name="theme-color"]:not([media])');
          if (meta) meta.setAttribute('content', bg);
        }
        apply();
        // ClientRouter swaps <html> attributes against the server-rendered
        // doc, which has no data-theme — re-apply after every transition.
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <PrerenderRules />
    <Analytics />
    <ClientRouter fallback="swap" />
    <slot name="head" />
  </head>
  <body>
    <nav class="skip-links" aria-label="Skip to">
      <a href="#main">Skip to content</a>
      <a href="#site-nav">Skip to navigation</a>
    </nav>
    <aside class="uc-banner" aria-label="Site status">
      /// under construction ///
    </aside>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <div id="route-announce" aria-live="polite" aria-atomic="true" class="sr-only"></div>
    <SearchPalette />
    <ShortcutsOverlay />
    <KeyboardShortcuts />
    <CopyButton />
    <PostBodyReveal />
    <script>
      import '~/lib/nav';
      import '~/lib/scroll-reveal';
    </script>
    <script>
      // Engages animation initial states (.reveal opacity:0, etc) AFTER
      // first paint. Crawlers / no-JS visitors see static content; real
      // users see animations engage post-paint.
      requestAnimationFrame(() => {
        document.documentElement.dataset.anim = '';
      });
      // Re-set after every ClientRouter swap (the html element is preserved
      // but be defensive against future Astro changes).
      document.addEventListener('astro:page-load', () => {
        document.documentElement.dataset.anim = '';
      });
    </script>
  </body>
</html>

<style>
  /* ASCII-only marker text on purpose: box-drawing / warning glyphs live in
     the extended font subset and would force its fetch on every page. */
  .uc-banner {
    background: var(--fg);
    color: var(--bg);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: center;
    padding: var(--space-2) var(--space-4);
  }
</style>
