---
import '~/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Analytics from '~/components/Analytics.astro';
import BaseHead from '~/components/BaseHead.astro';
import CopyButton from '~/components/CopyButton.astro';
import Footer from '~/components/Footer.astro';
import Header from '~/components/Header.astro';
import KeyboardShortcuts from '~/components/KeyboardShortcuts.astro';
import PrerenderRules from '~/components/PrerenderRules.astro';
import SearchPalette from '~/components/SearchPalette.astro';
import ShortcutsOverlay from '~/components/ShortcutsOverlay.astro';

interface Props {
  title: string;
  description?: string | undefined;
  canonical?: string | undefined;
  ogType?: 'website' | 'article' | undefined;
  ogImageUrl?: string | undefined;
  publishedTime?: Date | undefined;
  modifiedTime?: Date | undefined;
  tags?: string[] | undefined;
  lcpImage?: { srcset: string; sizes: string } | undefined;
}
const { title, description = '', ...rest } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} {...rest} />
    <link rel="preload" href="/fonts/jetbrains-mono.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#f5f4ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var prefers = matchMedia('(prefers-color-scheme: dark)').matches;
        var t = stored || (prefers ? 'dark' : 'light');
        document.documentElement.dataset.theme = t;
        document.documentElement.style.background = t === 'dark' ? '#0a0a0a' : '#f5f4ee';
      })();
    </script>
    <PrerenderRules />
    <Analytics />
    <ClientRouter fallback="swap" />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <div id="route-announce" aria-live="polite" aria-atomic="true" class="sr-only"></div>
    <SearchPalette />
    <ShortcutsOverlay />
    <KeyboardShortcuts />
    <CopyButton />
    <script>
      import '~/lib/nav';
      import '~/lib/scroll-reveal';
    </script>
  </body>
</html>
